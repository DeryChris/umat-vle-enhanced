# ============================================================
# PYTHON AI SERVICE
# ============================================================

# Virtual environment - each person creates their own locally
ai_service/venv/
ai_service/.venv/

# Python compiled files
ai_service/__pycache__/
ai_service/**/__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Environment file contains API keys - never commit this
ai_service/.env

# Uploaded files (temporary processing storage)
ai_service/uploads/*
!ai_service/uploads/.gitkeep

# ChromaDB vector database (built locally)
ai_service/chroma_db/*
!ai_service/chroma_db/.gitkeep

# Log files
ai_service/*.log
ai_service/logs/
ai_service_stderr.log
ai_service_stdout.log
ai_service/.llm_cache

# Pytest
ai_service/.pytest_cache/
ai_service/htmlcov/
ai_service/.coverage

