
# AI Service Configuration
AI_SERVICE_TOKEN=generate-a-long-random-string-here-minimum-32-chars
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# LLM provider: "gemini" (free tier), "openai" (billing), or "openrouter" (billing).
# Switching providers re-indexes into a separate vector collection, so course
# materials must be re-indexed after a switch (old index is kept, not lost).
LLM_PROVIDER=gemini

# Google Gemini (LLM + embeddings) — get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=given-gemini-api-key-here  # REPLACE WITH API KEY THAT WAS GIVEN

# NOTE: gemini-1.5-flash and text-embedding-004 are retired for new API keys.
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# OpenAI — only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter — only needed when LLM_PROVIDER=openrouter
# Uses OpenAI-compatible API; embeddings fall back to text-embedding-3-small via OpenAI key above.
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_SITE_URL=https://umat.edu.gh
OPENROUTER_SITE_NAME=UMaT AI VLE

# PostgreSQL for AI service
AI_DB_HOST=localhost
AI_DB_PORT=5432
AI_DB_NAME=umat_ai_db
AI_DB_USER=postgres
AI_DB_PASSWORD=0000 # REPLACE WITH YOUR ACTUAL DATABASE PASSWORD

# ChromaDB
CHROMA_DB_PATH=./chroma_db

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500

# Transcription API
# ---------------------------------------------------------------------------
# The transcription pipeline converts lecture recording audio to text using
# the OpenAI gpt-4o-mini-transcribe model (or local Whisper as fallback).
#
# How it works:
#   1. Audio is extracted from the BBB recording (FFmpeg) or uploaded file
#   2. Long audio (>10 min by default) is split into chunks with VAD
#   3. Each chunk is compressed to Opus @ 48kbps before sending to the API
#   4. Results are cached by file hash to avoid re-transcribing the same audio
#   5. Cost is tracked per job and passed back to Moodle for display
#
# Provider: "openai" (default, recommended), "openrouter" (experimental),
#           or "local" (Whisper base model, free but slower and less accurate)
#
# Get an OpenAI API key at: https://platform.openai.com/api-keys
# Required model access: gpt-4o-mini-transcribe (or gpt-4o-transcribe for premium)
# Estimated cost: ~$0.006 per minute of audio (gpt-4o-mini-transcribe)
# Fallback: When TRANSCRIPTION_API_KEY is empty, falls back to local Whisper
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Maximum chunk duration in seconds for splitting long audio (default: 600 = 10 min)
TRANSCRIPTION_MAX_CHUNK_SECS=600
# Enable response caching by file hash to avoid re-transcribing (default: true)
ENABLE_TRANSCRIPTION_CACHE=true

# Whisper ASR (local fallback when TRANSCRIPTION_API_KEY is empty)
# Options: tiny, base, small, medium, large
# base is good for development; use small or medium for production
WHISPER_MODEL=base

# Fast cloud transcription (OpenAI Whisper API) — ~1-3 seconds vs ~10-30s local.
# Set to your OpenAI API key (sk-...) for fast mode. Leave empty for local Whisper.
# NOTE: Your OPENAI_API_KEY above is an OpenRouter key (sk-or-v1-...) — that won't work here.
#       Get a direct OpenAI key at https://platform.openai.com/api-keys
OPENAI_WHISPER_API_KEY=

# Cloud transcription model — cheaper by default to stretch your budget.
#   gpt-4o-mini-transcribe  = $0.0006/min (~278 hrs per $10)  ← DEFAULT
#   gpt-4o-transcribe       = $0.006/min  (~28 hrs per $10)
#   gpt-4o-transcribe-diarize = $0.012/min (~14 hrs per $10, includes speaker labels)
#   whisper-1               = $0.006/min  (~28 hrs per $10)
OPENAI_WHISPER_MODEL=gpt-4o-mini-transcribe

# Speaker diarization — labels segments by speaker when using cloud Whisper API.
# WARNING: diarize model is 20x more expensive than mini!
OPENAI_WHISPER_DIARIZE=false

# Monthly budget cap for cloud transcription (USD). Set to 0 for unlimited.
# When running total exceeds this, cloud API falls back to local Whisper (free).
OPENAI_WHISPER_BUDGET_USD=10.0

# Path to local cost tracker file (JSON, auto-created)
OPENAI_WHISPER_COST_TRACKER_PATH=./.whisper_cost.json

# Chunking
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# LTI 1.3 (optional)
LTI_ENABLED=false
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_PLATFORM_ISSUER=
LTI_AUTH_LOGIN_URL=
LTI_AUTH_TOKEN_URL=
LTI_KEY_SET_URL=
LTI_TARGET_LINK_URI=http://localhost:8000/api/v1/lti/launch
LTI_PRIVATE_KEY_PATH=./lti_keys/private.key
LTI_KEY_ID=umat-ai-key-1