{{!
    @template theme_umat/navbar

    UMaT custom navbar — desktop uses Boost's sidebar drawer approach.
    This navbar only shows the top app bar with logo and user menu.
    Mobile bottom nav is in a separate template.
}}

<nav class="navbar umat-topbar fixed-top d-none d-md-flex" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid">
        <a href="{{{ config.homeurl }}}" class="navbar-brand d-flex align-items-center m-0 me-4 p-0 aabtn">
            {{# output.should_display_navbar_logo }}
                <img src="{{output.get_compact_logo_url}}" class="logo me-1" alt="{{sitename}}">
            {{/ output.should_display_navbar_logo }}
            {{^ output.should_display_navbar_logo }}
                <span class="umat-topbar-title">{{{ sitename }}}</span>
            {{/ output.should_display_navbar_logo }}
        </a>

        {{# output.page_heading_menu}}
            <ul class="navbar-nav d-flex my-1 px-1 umat-topbar-nav">
                {{{ output.page_heading_menu }}}
            </ul>
        {{/output.page_heading_menu}}

        <div id="usernavigation" class="navbar-nav ms-auto h-100">
            {{# output.search_box }}
                {{{ output.search_box }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/output.search_box}}
            {{#langmenu}}
                {{> theme_boost/language_menu }}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/langmenu}}
            {{{ output.navbar_plugin_output }}}
            <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                {{#usermenu}}
                    {{> core/user_menu }}
                {{/usermenu}}
            </div>
            {{{ output.edit_switch }}}
        </div>
    </div>
</nav>

{{> theme_boost/primary-drawer-mobile }}