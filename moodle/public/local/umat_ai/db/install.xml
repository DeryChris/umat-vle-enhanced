<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/umat_ai/db" VERSION="2026072201" COMMENT="UMaT AI plugin v2.1.1 schema">
  <TABLES>

<TABLE NAME="umat_ai_sessions" COMMENT="Tracks BBB recordings and uploaded lectures being processed by the AI service">
      <FIELDS>
        <FIELD NAME="id"             TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionid"      TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="courseid"       TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="userid"         TYPE="int"  LENGTH="10"  NOTNULL="false" DEFAULT="0"/>
        <FIELD NAME="cmid"           TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="source_type"    TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="bbb"/>
        <FIELD NAME="resource_type"  TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="bbb_recording"/>
        <FIELD NAME="recording_url"  TYPE="text" NOTNULL="false"/>
        <FIELD NAME="recording_path" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="upload_filename" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="transcript_json" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="status"         TYPE="char" LENGTH="30"  NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="studentvisible" TYPE="int"  LENGTH="2"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sessionid" UNIQUE="false" FIELDS="sessionid"/>
        <INDEX NAME="courseid"  UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_outputs" COMMENT="AI-generated content (summary, notes, quiz) pending lecturer approval">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionrecordid" TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid"        TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="output_type"     TYPE="char" LENGTH="30" NOTNULL="true"/>
        <FIELD NAME="content"         TYPE="text" NOTNULL="false"/>
        <FIELD NAME="is_approved"     TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="approved_by"     TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timepublished"   TYPE="int"  LENGTH="10" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"          TYPE="primary"  FIELDS="id"/>
        <KEY NAME="sessionrecord_fk" TYPE="foreign"  FIELDS="sessionrecordid" REFTABLE="umat_ai_sessions" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_approved" UNIQUE="false" FIELDS="courseid,is_approved"/>
      </INDEXES>
    </TABLE>

<TABLE NAME="umat_ai_materials" COMMENT="Lecturer-uploaded materials indexed for RAG">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="cmid"        TYPE="int"  LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="fileid"      TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="filename"    TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="is_indexed"  TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="is_analyzed" TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeindexed" TYPE="int"  LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="timeanalyzed" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="studentvisible" TYPE="int"  LENGTH="2"   NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/></INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_analysis" COMMENT="Mirrored metadata from AI service material analyses for fast Moodle-side status checks">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"      TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="materialid"    TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="fileid"        TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="analysis_type" TYPE="char" LENGTH="50"  NOTNULL="true"/>
        <FIELD NAME="scope"         TYPE="char" LENGTH="50"  NOTNULL="true" DEFAULT="full"/>
        <FIELD NAME="status"        TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="ai_analysis_id" TYPE="int" LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="model_version" TYPE="char" LENGTH="100" NOTNULL="false"/>
        <FIELD NAME="token_count"   TYPE="int"  LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="summary"       TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"    TYPE="primary" FIELDS="id"/>
        <KEY NAME="material_fk" TYPE="foreign" FIELDS="materialid" REFTABLE="umat_ai_materials" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid"        UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="material_type"   UNIQUE="false" FIELDS="materialid,analysis_type"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_chat_logs" COMMENT="Student Q&amp;A interactions — session-keyed for conversation grouping">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="session_key" TYPE="char" LENGTH="64"  NOTNULL="false"/>
        <FIELD NAME="role"        TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="student"/>
        <FIELD NAME="question"    TYPE="text" NOTNULL="true"/>
        <FIELD NAME="answer"      TYPE="text" NOTNULL="false"/>
        <FIELD NAME="sources"     TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="userid_courseid" UNIQUE="false" FIELDS="userid,courseid"/>
        <INDEX NAME="session_key"     UNIQUE="false" FIELDS="session_key"/>
        <INDEX NAME="timecreated"     UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_chat_log_helpfulness" COMMENT="Student feedback ratings on AI answers">
      <FIELDS>
        <FIELD NAME="id"                  TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="chatlogid"           TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="userid"              TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="rating"              TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated"         TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="chatlog_fk" TYPE="foreign" FIELDS="chatlogid" REFTABLE="umat_ai_chat_logs" REFFIELDS="id" ONDELETE="cascade"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_material_progress" COMMENT="Student progress tracking through course materials via beacon">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"          TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="courseid"        TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="materialid"      TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="progress_pct"    TYPE="number" LENGTH="5" DECIMALS="1" NOTNULL="true" DEFAULT="0.0"/>
        <FIELD NAME="time_spent_sec"  TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="last_position"   TYPE="int"    LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="timemodified"    TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="material_fk" TYPE="foreign" FIELDS="materialid" REFTABLE="umat_ai_materials" REFFIELDS="id" ONDELETE="cascade"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="user_course_material" UNIQUE="true" FIELDS="userid,courseid,materialid"/>
        <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_topic_friction" COMMENT="Materialized per-topic friction scores from chat logs and struggle data">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"        TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="topic_label"     TYPE="char"   LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="question_volume" TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="friction_score"  TYPE="number" LENGTH="5" DECIMALS="1" NOTNULL="true" DEFAULT="0.0"/>
        <FIELD NAME="student_count"   TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="severity"        TYPE="char"   LENGTH="20"  NOTNULL="true" DEFAULT="minor"/>
        <FIELD NAME="computed_at"     TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_topic" UNIQUE="true" FIELDS="courseid,topic_label"/>
        <INDEX NAME="course_severity" UNIQUE="false" FIELDS="courseid,severity"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_metric_trends" COMMENT="30-day rolling snapshots for sparkline charts">
      <FIELDS>
        <FIELD NAME="id"               TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"         TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="engagement_score" TYPE="number" LENGTH="5" DECIMALS="1" NOTNULL="true" DEFAULT="0.0"/>
        <FIELD NAME="at_risk_count"    TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="total_students"   TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="snapshot_date"    TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_date" UNIQUE="false" FIELDS="courseid,snapshot_date"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_lecturer_notes" COMMENT="Lecturer AI assistant interaction log">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="session_key" TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="query"       TYPE="text" NOTNULL="true"/>
        <FIELD NAME="response"    TYPE="text" NOTNULL="false"/>
        <FIELD NAME="sources"     TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="userid_courseid" UNIQUE="false" FIELDS="userid,courseid"/>
        <INDEX NAME="session_key"     UNIQUE="false" FIELDS="session_key"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_student_context" COMMENT="Per-student struggle areas detected by event observers">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"          TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="courseid"        TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="cmid"            TYPE="int"    LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="topic_label"     TYPE="char"   LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="struggle_reason" TYPE="char"   LENGTH="50"  NOTNULL="false"/>
        <FIELD NAME="struggle_score"  TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="is_struggle"     TYPE="int"    LENGTH="1"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"     TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"    TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="user_course" UNIQUE="false" FIELDS="userid,courseid"/>
        <INDEX NAME="user_course_cmid" UNIQUE="false" FIELDS="userid,courseid,cmid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_activity_log" COMMENT="Raw student activity events for analytics webhooks">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="cmid"        TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="event_type"  TYPE="char" LENGTH="50" NOTNULL="true"/>
        <FIELD NAME="event_data"  TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="user_course_type" UNIQUE="false" FIELDS="userid,courseid,event_type"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_issue_reports" COMMENT="Student-submitted issues/complaints about course content">
      <FIELDS>
        <FIELD NAME="id"               TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"           TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="courseid"         TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="category"         TYPE="char" LENGTH="30"  NOTNULL="true" DEFAULT="other"/>
        <FIELD NAME="topic"            TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="description"      TYPE="text" NOTNULL="true"/>
        <FIELD NAME="status"           TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="open"/>
        <FIELD NAME="lecturer_notes"   TYPE="text" NOTNULL="false"/>
        <FIELD NAME="lecturer_response" TYPE="text" NOTNULL="false" COMMENT="Legacy public lecturer response"/>
        <FIELD NAME="response_seen"    TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" COMMENT="Legacy response read flag"/>
        <FIELD NAME="reporter_name"    TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="Name provided by unauthenticated reporter"/>
        <FIELD NAME="reporter_username" TYPE="char" LENGTH="100" NOTNULL="false" COMMENT="Username/idnumber provided by unauthenticated reporter"/>
        <FIELD NAME="timecreated"      TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"     TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="user_course" UNIQUE="false" FIELDS="userid,courseid"/>
        <INDEX NAME="course_status" UNIQUE="false" FIELDS="courseid,status"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_issue_conversations" COMMENT="Private student and lecturer course issue conversations">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"        TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="studentid"       TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="title"           TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="category"        TYPE="char" LENGTH="30"  NOTNULL="true" DEFAULT="other"/>
        <FIELD NAME="clientid"        TYPE="char" LENGTH="64"  NOTNULL="true"/>
        <FIELD NAME="legacyissueid"   TYPE="int"  LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="lastmessagetime" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course_fk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="student_fk" TYPE="foreign" FIELDS="studentid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="student_course_client" UNIQUE="true" FIELDS="studentid,courseid,clientid"/>
        <INDEX NAME="legacyissue" UNIQUE="true" FIELDS="legacyissueid"/>
        <INDEX NAME="course_lastmessage" UNIQUE="false" FIELDS="courseid,lastmessagetime"/>
        <INDEX NAME="student_course_lastmessage" UNIQUE="false" FIELDS="studentid,courseid,lastmessagetime"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_issue_messages" COMMENT="Messages and receipts in private issue conversations">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="conversationid"  TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="senderid"        TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="senderrole"      TYPE="char" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="body"            TYPE="text" NOTNULL="true"/>
        <FIELD NAME="clientid"        TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="attachmentcount" TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="deliveredat"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="viewedat"        TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="conversation_fk" TYPE="foreign" FIELDS="conversationid" REFTABLE="umat_ai_issue_conversations" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="conversation_sender_client" UNIQUE="true" FIELDS="conversationid,senderid,clientid"/>
        <INDEX NAME="conversation_time" UNIQUE="false" FIELDS="conversationid,timecreated"/>
        <INDEX NAME="conversation_receipt" UNIQUE="false" FIELDS="conversationid,senderrole,viewedat"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_login_lookup_log" COMMENT="Rate-limiting log for login-page course lookups (5/min per IP)">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="ip_address"  TYPE="char" LENGTH="45"  NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="ip_time" UNIQUE="false" FIELDS="ip_address,timecreated"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_notes" COMMENT="Student's own notes with tagging support">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="title"       TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="content"     TYPE="text" NOTNULL="false"/>
        <FIELD NAME="pinned"      TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="user_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_courseid" UNIQUE="false" FIELDS="userid,courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_note_tags" COMMENT="Polymorphic tags on notes">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="noteid"      TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="tag_type"    TYPE="char" LENGTH="50"  NOTNULL="true"/>
        <FIELD NAME="tag_id"      TYPE="int"  LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="tag_label"   TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="tag_value"   TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="note_fk" TYPE="foreign" FIELDS="noteid" REFTABLE="umat_ai_notes" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="tag_type" UNIQUE="false" FIELDS="tag_type,tag_id"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_quiz_attempts" COMMENT="Student quiz attempts on AI-generated practice quizzes">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"          TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="courseid"        TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="session_key"     TYPE="char" LENGTH="64"  NOTNULL="false"/>
        <FIELD NAME="quiz_title"      TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT=""/>
        <FIELD NAME="questions_json"  TYPE="text" NOTNULL="false"/>
        <FIELD NAME="answers_json"    TYPE="text" NOTNULL="false"/>
        <FIELD NAME="graded_json"     TYPE="text" NOTNULL="false"/>
        <FIELD NAME="score"           TYPE="int"  LENGTH="4"   NOTNULL="false"/>
        <FIELD NAME="total"           TYPE="int"  LENGTH="4"   NOTNULL="false"/>
        <FIELD NAME="status"          TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="in_progress"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_qa_user_course" UNIQUE="false" FIELDS="userid,courseid"/>
        <INDEX NAME="idx_qa_status"      UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_quizgen_jobs" COMMENT="Tracks AI quiz generation jobs from draft request through XML import">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"        TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="userid"          TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="material_id"     TYPE="int"  LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="source_text"     TYPE="text" NOTNULL="false"/>
        <FIELD NAME="config_json"     TYPE="text" NOTNULL="true"/>
        <FIELD NAME="category_name"   TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="status"          TYPE="char" LENGTH="30"  NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="questions_json"  TYPE="text" NOTNULL="false"/>
        <FIELD NAME="xml_content"     TYPE="text" NOTNULL="false"/>
        <FIELD NAME="quiz_id"         TYPE="int"  LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="failure_reason"  TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_status" UNIQUE="false" FIELDS="courseid,status"/>
        <INDEX NAME="user_course"   UNIQUE="false" FIELDS="userid,courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_student_metrics" COMMENT="Hourly aggregated student engagement and risk metrics">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"          TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="courseid"        TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="logins"          TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="avg_quiz_grade"  TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="ai_questions_asked" TYPE="int" LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="risk_score"      TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="last_active"     TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="risk_level"      TYPE="char"   LENGTH="20"  NOTNULL="false"/>
        <FIELD NAME="confidence"      TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false"/>
        <FIELD NAME="classification"  TYPE="char"   LENGTH="50"  NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_user" UNIQUE="false" FIELDS="courseid,userid"/>
        <INDEX NAME="course_risk" UNIQUE="false" FIELDS="courseid,risk_score"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_interventions" COMMENT="Log of lecturer actions to prevent intervention spam">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="lecturerid"  TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="action_type" TYPE="char" LENGTH="50"  NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="user_course_action" UNIQUE="false" FIELDS="userid,courseid,action_type,timecreated"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_group_study" COMMENT="Study group sessions for collaborative AI chat">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="name"        TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="max_members" TYPE="int"  LENGTH="4"   NOTNULL="true" DEFAULT="5"/>
        <FIELD NAME="status"      TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="open"/>
        <FIELD NAME="created_by"  TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"    TYPE="primary" FIELDS="id"/>
        <KEY NAME="course_fk"  TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="creator_fk" TYPE="foreign" FIELDS="created_by" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_gs_status" UNIQUE="false" FIELDS="courseid,status"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_group_members" COMMENT="Membership in study groups">
      <FIELDS>
        <FIELD NAME="id"         TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="groupid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"     TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="role"       TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="member"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"   TYPE="primary" FIELDS="id"/>
        <KEY NAME="group_fk"  TYPE="foreign" FIELDS="groupid" REFTABLE="umat_ai_group_study" REFFIELDS="id"/>
        <KEY NAME="member_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_gm_user"  UNIQUE="false" FIELDS="userid,groupid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_group_messages" COMMENT="Group chat messages and shared AI Q&amp;A">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="groupid"     TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="message"     TYPE="text" NOTNULL="false" COMMENT="Free-form chat text"/>
        <FIELD NAME="question"    TYPE="text" NOTNULL="false" COMMENT="AI question (null for chat messages)"/>
        <FIELD NAME="answer"      TYPE="text" NOTNULL="false" COMMENT="AI answer"/>
        <FIELD NAME="sources"     TYPE="text" NOTNULL="false" COMMENT="AI source citations"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"     TYPE="primary" FIELDS="id"/>
        <KEY NAME="gmsg_group"  TYPE="foreign" FIELDS="groupid" REFTABLE="umat_ai_group_study" REFFIELDS="id"/>
        <KEY NAME="gmsg_user"   TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_gm_time"    UNIQUE="false" FIELDS="groupid,timecreated"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_videos" COMMENT="AI-generated lecture videos from course materials">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="materialid"  TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="job_id"      TYPE="char" LENGTH="100" NOTNULL="false"/>
        <FIELD NAME="status"      TYPE="char" LENGTH="30"  NOTNULL="true" DEFAULT="queued"/>
        <FIELD NAME="video_url"   TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"     TYPE="primary" FIELDS="id"/>
        <KEY NAME="material_fk" TYPE="foreign" FIELDS="materialid" REFTABLE="umat_ai_materials" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_resource_items" COMMENT="Lecturer private resource bank items (files + folders)">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10"  NOTNULL="false"/>
