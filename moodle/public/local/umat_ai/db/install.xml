<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/umat_ai/db" VERSION="20260518" COMMENT="UMaT AI plugin v1.2 schema">
  <TABLES>

    <TABLE NAME="umat_ai_sessions" COMMENT="Tracks BBB recordings being processed by the AI service">
      <FIELDS>
        <FIELD NAME="id"             TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionid"      TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="courseid"       TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="cmid"           TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="recording_url"  TYPE="text" NOTNULL="false"/>
        <FIELD NAME="recording_path" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="transcript_json" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="status"         TYPE="char" LENGTH="30"  NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="timecreated"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sessionid" UNIQUE="false" FIELDS="sessionid"/>
        <INDEX NAME="courseid"  UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_outputs" COMMENT="AI-generated content (summary, notes, quiz) pending lecturer approval">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionrecordid" TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid"        TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="output_type"     TYPE="char" LENGTH="30" NOTNULL="true"/>
        <FIELD NAME="content"         TYPE="text" NOTNULL="false"/>
        <FIELD NAME="is_approved"     TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="approved_by"     TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timepublished"   TYPE="int"  LENGTH="10" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"          TYPE="primary"  FIELDS="id"/>
        <KEY NAME="sessionrecord_fk" TYPE="foreign"  FIELDS="sessionrecordid" REFTABLE="umat_ai_sessions" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_approved" UNIQUE="false" FIELDS="courseid,is_approved"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_materials" COMMENT="Lecturer-uploaded materials indexed for RAG">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="cmid"        TYPE="int"  LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="fileid"      TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="filename"    TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="is_indexed"  TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/></INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_chat_logs" COMMENT="Student Q&amp;A interactions — session-keyed for conversation grouping">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="session_key" TYPE="char" LENGTH="64"  NOTNULL="false"/>
        <FIELD NAME="role"        TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="student"/>
        <FIELD NAME="question"    TYPE="text" NOTNULL="true"/>
        <FIELD NAME="answer"      TYPE="text" NOTNULL="false"/>
        <FIELD NAME="sources"     TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="userid_courseid" UNIQUE="false" FIELDS="userid,courseid"/>
        <INDEX NAME="session_key"     UNIQUE="false" FIELDS="session_key"/>
        <INDEX NAME="timecreated"     UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="umat_ai_lecturer_notes" COMMENT="Lecturer AI assistant interaction log">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="query"       TYPE="text" NOTNULL="true"/>
        <FIELD NAME="response"    TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="userid_courseid" UNIQUE="false" FIELDS="userid,courseid"/></INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
