{{!
    Template: local/umat_ai/templates/ai_chat_panel.mustache
    Renders the AI chat panel FAB + expandable overlay on any page.

    Uses CSS variables that inherit from theme or fall back to defaults.
    Works standalone or with any Moodle theme.

    Context variables:
    - courseid (int, optional) — for course-specific context
    - coursename (string, optional)
    - has_capability (bool) — whether user can use the chat
    - indexed (bool) — whether course materials are indexed
    - is_global (bool) — true if shown on non-course pages (enables expand)
}}

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200">

<style>
/* ====================================================
   UMaT AI Chat Panel — Claude-Like Glassmorphic Design
   Inherits global tokens from umat-overlay.css when present;
   defines safe fallbacks when used standalone.
   ==================================================== */
:root {
    --acp-p:    #006b2f;
    --acp-pb:   #00873d;
    --acp-op:   #ffffff;
    --acp-sf:   rgba(245,251,240,0.7);
    --acp-sflo: rgba(255,255,255,0.78);
    --acp-sfl:  rgba(239,246,235,0.72);
    --acp-ons:  #171d17;
    --acp-onsv: #2c352c;
    --acp-ol:   #5b665a;
    --acp-olv:  rgba(189,202,186,0.4);
    --acp-sec:  #3d6844;
    --acp-secc: rgba(190,239,193,0.5);
    --acp-ok:   #4ade80;
    --acp-r8:   12px;
    --acp-r12:  18px;
    --acp-r16:  24px;
    --acp-rp:   9999px;
    --acp-shadow: 0 20px 60px -10px rgba(0,53,128,0.12), 0 8px 24px -6px rgba(0,107,47,0.06);
    --acp-fshadow: 0 8px 28px rgba(0,107,47,.28), 0 3px 10px rgba(0,107,47,.12);
    --acp-cb: cubic-bezier(.4,0,.2,1);
    --acp-cbi: cubic-bezier(.175,0.885,0.32,1.275);
}

/* --- Keyframes --- */
@keyframes acp-fade{from{opacity:0;transform:translateY(18px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes acp-slide{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:none}}
@keyframes acp-blink{0%,100%{opacity:1}50%{opacity:.35}}
@keyframes acp-dots{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-6px)}}
@keyframes acp-pulse{0%{box-shadow:var(--acp-fshadow),0 0 0 0 rgba(0,107,47,.5)}70%{box-shadow:var(--acp-fshadow),0 0 0 14px rgba(0,107,47,0)}100%{box-shadow:var(--acp-fshadow),0 0 0 0 rgba(0,107,47,0)}}

/* --- FAB --- */
.ai-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--acp-p), var(--acp-pb)) !important;
    color: var(--acp-op) !important;
    border: none;
    box-shadow: var(--acp-fshadow);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform .25s var(--acp-cb), box-shadow .25s var(--acp-cb);
    animation: acp-pulse 2.8s infinite;
    font-family: Inter, -apple-system, sans-serif;
    text-decoration: none;
    -webkit-user-select: none;
    user-select: none;
}
.ai-fab:hover {
    transform: scale(1.1);
    box-shadow: 0 10px 32px rgba(0,107,47,.55);
    animation: none;
}
.ai-fab:active { transform: scale(.95); }
.ai-fab .material-symbols-outlined {
    font-size: 26px;
    transition: transform .25s var(--acp-cbi);
}
.ai-fab:hover .material-symbols-outlined { transform: scale(1.1) rotate(-8deg); }

/* --- Overlay backdrop --- */
.ai-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: flex-end;
    justify-content: flex-end;
    font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
}
@media (max-width: 768px) {
    .ai-overlay { align-items: center; justify-content: center; }
}
.ai-overlay.show { display: flex; }

.ai-backdrop {
    position: absolute;
    inset: 0;
    /* Make backdrop transparent so native Moodle page content remains visible */
    background: rgba(247, 251, 243, 0);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: opacity .3s;
}

/* --- Panel --- */
.ai-panel {
    position: relative;
    width: 430px;
    max-width: 95vw;
    height: 72vh;
    max-height: 620px;
    background: var(--acp-sflo);
    backdrop-filter: blur(24px) saturate(190%);
    -webkit-backdrop-filter: blur(24px) saturate(190%);
    border: 1px solid rgba(255,255,255,.45);
    border-radius: var(--acp-r16);
    box-shadow: var(--acp-shadow);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    margin: 16px;
    animation: acp-fade .38s var(--acp-cb) forwards;
    transition: width .3s var(--acp-cb), height .3s var(--acp-cb), border-radius .3s var(--acp-cb);
}

/* Expanded */
.ai-overlay.expanded .ai-panel {
    width: 100vw;
    height: 100vh;
    max-height: 100vh;
    max-width: 100vw;
    margin: 0;
    border-radius: 0;
}

/* --- Panel Header --- */
.ai-panel-header {
    background: linear-gradient(135deg, var(--acp-p) 0%, var(--acp-pb) 100%);
    padding: 15px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--acp-op);
    flex-shrink: 0;
}
.ai-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,.2);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    flex-shrink: 0;
}
.ai-avatar .material-symbols-outlined { font-size: 22px; }
.ai-avatar-dot {
    position: absolute;
    bottom: 1px;
    right: 1px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--acp-ok);
    border: 2px solid var(--acp-p);
    animation: acp-blink 2s infinite;
}
.ai-title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
}
.ai-status {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    opacity: .82;
    margin-top: 2px;
}
.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--acp-ok);
}
.ai-header-actions {
    margin-left: auto;
    display: flex;
    gap: 6px;
}
.ai-expand-btn, .ai-close-btn {
    background: rgba(255,255,255,.18);
    border: none;
    color: var(--acp-op);
    cursor: pointer;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .2s;
    flex-shrink: 0;
}
.ai-expand-btn:hover, .ai-close-btn:hover { background: rgba(255,255,255,.3); }
.ai-expand-btn .material-symbols-outlined,
.ai-close-btn .material-symbols-outlined { font-size: 17px; }

/* --- Messages area --- */
.ai-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px 14px;
    background: var(--acp-sf);
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-behavior: smooth;
}
.ai-messages::-webkit-scrollbar { width: 4px; }
.ai-messages::-webkit-scrollbar-track { background: transparent; }
.ai-messages::-webkit-scrollbar-thumb { background: var(--acp-olv); border-radius: 2px; }

/* Claude-style message bubbles — uses global umat- classes */
.umat-msg-ai {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    animation: acp-slide .32s var(--acp-cb) forwards;
}
.umat-msg-ai-ic {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(0,107,47,.12);
    color: var(--acp-p);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.umat-msg-ai-ic .material-symbols-outlined { font-size: 15px; }
.umat-msg-ai-wrap { display: flex; flex-direction: column; gap: 4px; }
.umat-msg-lbl { font-size: 10px; font-weight: 700; color: var(--acp-p); letter-spacing: .04em; }
.umat-bubble-ai {
    background: rgba(255,255,255,0.62);
    border: 1px solid rgba(255,255,255,.42);
    border-left: 3.5px solid var(--acp-p);
    padding: 11px 15px;
    border-radius: 4px var(--acp-r12) var(--acp-r12) var(--acp-r12);
    font-size: 14px;
    line-height: 1.65;
    color: var(--acp-ons);
    box-shadow: 0 2px 12px rgba(0,53,128,.03);
    transition: all .25s ease;
}
.umat-bubble-ai p { margin: 0; }
.umat-ai-content p { margin: 5px 0; }
.umat-ai-content p:first-child { margin-top: 0; }
.umat-ai-content p:last-child { margin-bottom: 0; }
.umat-ai-content strong { font-weight: 700; color: var(--acp-ons); }
.umat-ai-content em { font-style: italic; }
.umat-ai-content code {
    background: var(--acp-sfl);
    border: 1px solid var(--acp-olv);
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 12px;
    font-family: 'Cascadia Code','Fira Code','JetBrains Mono',Consolas,monospace;
}
.umat-ai-content h2 { margin: 12px 0 5px; font-size: 14px; font-weight: 700; }
.umat-ai-content h3 { margin: 10px 0 4px; font-size: 13px; font-weight: 700; }
.umat-ai-content ul, .umat-ai-content ol { margin: 5px 0; padding-left: 20px; }
.umat-ai-content li { margin: 3px 0; line-height: 1.55; }
.umat-ai-content hr { border: none; border-top: 1.5px solid var(--acp-olv); margin: 10px 0; }
.umat-ai-stream-content { min-height: 1em; }

/* User bubble */
.umat-msg-user {
    display: flex;
    justify-content: flex-end;
    animation: acp-slide .32s var(--acp-cb) forwards;
}
.umat-bubble-user {
    background: rgba(220,245,227,0.78);
    border: 1px solid rgba(255,255,255,.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #0c381e;
    padding: 11px 15px;
    border-radius: var(--acp-r12) var(--acp-r12) 4px var(--acp-r12);
    font-size: 14px;
    line-height: 1.65;
    max-width: 86%;
    box-shadow: 0 2px 12px rgba(0,107,47,.05);
}
.umat-bubble-user p { margin: 0; }

/* Typing indicator */
.umat-typing { display: flex; gap: 4px; padding: 6px 0; }
.umat-typing span {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--acp-p);
    animation: acp-dots 1.2s infinite;
}
.umat-typing span:nth-child(2) { animation-delay: .2s; }
.umat-typing span:nth-child(3) { animation-delay: .4s; }

/* Source chips */
.umat-src-chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
.umat-src-chip {
    padding: 2px 8px;
    border-radius: var(--acp-rp);
    background: var(--acp-secc);
    color: var(--acp-sec);
    font-size: 10px;
    font-weight: 700;
}

/* --- Quick Actions --- */
.ai-quick-actions {
    padding: 10px 14px;
    border-top: 1px solid var(--acp-olv);
    background: var(--acp-sflo);
    flex-shrink: 0;
}
.quick-actions-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
}
.quick-action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 4px;
    background: rgba(255,255,255,.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,.45);
    border-radius: var(--acp-r8);
    cursor: pointer;
    font-size: 10px;
    font-weight: 600;
    color: var(--acp-onsv);
    font-family: inherit;
    transition: all .25s var(--acp-cbi);
}
.quick-action-btn:hover {
    border-color: var(--acp-p);
    background: rgba(0,107,47,.05);
    transform: translateY(-2px);
    color: var(--acp-p);
}
.quick-action-btn:active { transform: translateY(0); }
.quick-action-btn .material-symbols-outlined {
    font-size: 18px;
    color: var(--acp-p);
    transition: transform .2s var(--acp-cbi);
}
.quick-action-btn:hover .material-symbols-outlined { transform: scale(1.12); }

/* --- Input Area --- */
.ai-input-area {
    padding: 11px 14px;
    border-top: 1px solid var(--acp-olv);
    background: var(--acp-sflo);
    flex-shrink: 0;
}
.ai-input-wrapper { display: flex; gap: 8px; align-items: flex-end; }
.ai-input-wrapper textarea {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid rgba(0,0,0,.08);
    border-radius: var(--acp-r12);
    font-size: 14px;
    resize: none;
    font-family: inherit;
    max-height: 100px;
    line-height: 1.5;
    color: var(--acp-ons);
    background: rgba(255,255,255,.85);
    box-shadow: 0 2px 10px rgba(0,0,0,.02);
    transition: border-color .25s, box-shadow .25s;
    outline: none;
}
.ai-input-wrapper textarea:focus {
    border-color: var(--acp-p);
    box-shadow: 0 0 0 3px rgba(0,107,47,.12);
}
.ai-input-wrapper textarea::placeholder { color: var(--acp-ol); opacity: .7; }
.ai-input-wrapper textarea:disabled { opacity: .5; cursor: not-allowed; }
.ai-send-btn {
    width: 40px;
    height: 40px;
    border-radius: var(--acp-r8);
    background: var(--acp-p);
    color: var(--acp-op);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background .2s, transform .2s;
}
.ai-send-btn .material-symbols-outlined {
    font-size: 19px;
    transition: transform .2s var(--acp-cbi);
}
.ai-send-btn:hover { background: var(--acp-pb); }
.ai-send-btn:hover .material-symbols-outlined { transform: scale(1.1); }
.ai-send-btn:active { transform: scale(.92); }
.ai-send-btn:disabled { opacity: .5; cursor: not-allowed; }

/* Premium glass polish shared with overlay widgets. */
.ai-panel,.ai-session-sidebar,.ai-quick-actions,.ai-input-area,.ai-messages {
    background: rgba(255,255,255,.62);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
}
.ai-panel-header {
    background: linear-gradient(135deg,#006b2f 0%,#0b8f47 48%,#b9aa4f 145%);
    background-size: 180% 180%;
    animation: acp-flow 9s ease infinite;
}
@keyframes acp-flow { 0%{background-position:0% 50%} 50%{background-position:100% 50%} 100%{background-position:0% 50%} }
.umat-bubble-ai {
    background: rgba(255,255,255,.52);
    backdrop-filter: blur(16px) saturate(175%);
    -webkit-backdrop-filter: blur(16px) saturate(175%);
    border-left: 1px solid rgba(255,255,255,.5);
    border-radius: 22px;
    padding: 15px 18px;
    box-shadow: 0 14px 38px rgba(0,53,128,.055);
}
.umat-bubble-user {
    border-radius: 22px 22px 6px 22px;
    background: rgba(220,245,227,.82);
    box-shadow: 0 12px 30px rgba(0,107,47,.07);
}
.umat-ai-stream-content::after {
    content: ' ';
    display: inline-block;
    width: 6px;
    height: 1.1em;
    margin-left: 2px;
    border-radius: 999px;
    background: rgba(0,107,47,.62);
    vertical-align: -.16em;
    animation: acp-blink 1s infinite;
}
.quick-action-btn,.ai-input-wrapper textarea,.umat-src-chip {
    background: rgba(255,255,255,.64);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-color: rgba(255,255,255,.5);
}

.ai-input-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
    font-size: 11px;
    color: var(--acp-ol);
}
.ai-input-footer a {
    color: var(--acp-p);
    font-size: 11px;
    text-decoration: none;
    transition: opacity .2s;
}
.ai-input-footer a:hover { opacity: .7; }

/* Final opaque overlay override: never reveal native Moodle page behind panels. */
.ai-overlay,.ai-backdrop {
    background: #f7fbf3 !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
}
.ai-panel {
    background: rgba(255,255,255,.78) !important;
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
}

/* --- Expanded full-page layout --- */
.ai-full-content {
    display: none;
    flex: 1;
    overflow-y: auto;
}
.ai-overlay.expanded .ai-full-content {
    display: flex;
    flex-direction: row;
}
.ai-overlay.expanded .ai-messages-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--acp-olv);
}
.ai-overlay.expanded .ai-messages-area .ai-messages {
    flex: 1;
    max-height: none;
}
.ai-session-sidebar {
    width: 280px;
    background: var(--acp-sflo);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: none;
    flex-direction: column;
    border-right: 1px solid var(--acp-olv);
}
.ai-overlay.expanded .ai-session-sidebar { display: flex; }
.sidebar-header {
    padding: 16px;
    border-bottom: 1px solid var(--acp-olv);
    font-weight: 700;
    font-size: 13px;
    color: var(--acp-ons);
}
.sidebar-search {
    padding: 10px 14px;
    border-bottom: 1px solid var(--acp-olv);
}
.sidebar-search input {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--acp-olv);
    border-radius: var(--acp-r8);
    font-size: 13px;
    font-family: inherit;
    outline: none;
    background: var(--acp-sfl);
    transition: border-color .2s;
}
.sidebar-search input:focus { border-color: var(--acp-p); }
.session-list { flex: 1; overflow-y: auto; }
.session-item {
    padding: 12px 16px;
    border-bottom: 1px solid var(--acp-olv);
    cursor: pointer;
    transition: background .2s;
}
.session-item:hover { background: var(--acp-sfl); }
.session-item.active {
    background: rgba(0,107,47,.07);
    border-left: 3px solid var(--acp-p);
}
.session-item-title { font-size: 13px; font-weight: 600; color: var(--acp-ons); margin-bottom: 3px; }
.session-item-preview { font-size: 12px; color: var(--acp-ol); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.session-item-time { font-size: 11px; color: var(--acp-ol); margin-top: 3px; }

/* Stats section (expanded mode) */
.ai-stats-section {
    padding: 16px;
    border-bottom: 1px solid var(--acp-olv);
    display: none;
}
.ai-overlay.expanded .ai-stats-section { display: block; }
.ai-stats-title { font-size: 13px; font-weight: 700; color: var(--acp-ons); margin-bottom: 12px; }
.ai-stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
.ai-stat-card {
    background: rgba(255,255,255,.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,.45);
    padding: 12px;
    border-radius: var(--acp-r8);
    text-align: center;
    transition: transform .25s var(--acp-cbi);
}
.ai-stat-card:hover { transform: translateY(-2px); }
.ai-stat-value { font-size: 22px; font-weight: 800; color: var(--acp-p); }
.ai-stat-label { font-size: 11px; color: var(--acp-ol); margin-top: 2px; }
</style>

/* FAB Button */
.ai-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: var(--ai-primary) !important;
    color: white !important;
    border: none;
    box-shadow: 0 4px 12px var(--ai-shadow);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.ai-fab:hover {
    transform: scale(1.08);
    box-shadow: 0 8px 20px rgba(0,107,47,0.3);
}
.ai-fab .material-symbols-outlined {
    font-size: 28px;
}

/* Overlay */
.ai-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: flex-end;
    justify-content: flex-end;
}
@media (max-width: 768px) {
    .ai-overlay {
        align-items: center;
        justify-content: center;
    }
}
.ai-overlay.show { display: flex; }

/* Backdrop */
.ai-backdrop {
    position: absolute;
    inset: 0;
    background-color: #f7fbf3;
    backdrop-filter: none;
}

/* Panel - Collapsed (chat) */
.ai-panel {
    position: relative;
    width: 420px;
    max-width: 95vw;
    height: 70vh;
    max-height: 600px;
    background-color: var(--ai-surface);
    border-radius: var(--ai-radius);
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    margin: 16px;
    transition: width 0.3s ease, height 0.3s ease, max-height 0.3s ease, border-radius 0.3s ease;
}

/* Panel - Expanded (full page) */
.ai-overlay.expanded .ai-panel {
    width: 100vw;
    height: 100vh;
    max-height: 100vh;
    max-width: 100vw;
    margin: 0;
    border-radius: 0;
}

/* Panel Header */
.ai-panel-header {
    background: linear-gradient(135deg, var(--ai-primary) 0%, var(--ai-primary-light) 100%);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: white;
    flex-shrink: 0;
}
.ai-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
}
.ai-title {
    font-size: 16px;
    font-weight: 600;
}
.ai-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    opacity: 0.9;
}
.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--ai-success);
    animation: blink 2s infinite;
}
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
.ai-header-actions {
    margin-left: auto;
    display: flex;
    gap: 8px;
}
.ai-expand-btn {
    background: transparent;
    border: none;
    color: white;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    opacity: 0.8;
    transition: opacity 0.2s;
}
.ai-expand-btn:hover { opacity: 1; }
.ai-expand-btn .material-symbols-outlined {
    font-size: 20px;
}
.ai-close-btn {
    background: transparent;
    border: none;
    color: white;
    cursor: pointer;
    padding: 4px;
}

/* Chat Messages */
.ai-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    background-color: var(--ai-surface-alt);
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.chat-message { display: flex; max-width: 85%; }
.chat-message.ai { align-self: flex-start; }
.chat-message.user { align-self: flex-end; }
.chat-bubble {
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.5;
}
.chat-message.ai .chat-bubble {
    background-color: var(--ai-surface);
    border-left: 3px solid var(--ai-primary);
}
.chat-message.user .chat-bubble {
    background-color: var(--ai-user-bubble);
    color: var(--ai-user-text);
}

/* Quick Actions */
.ai-quick-actions {
    padding: 12px 16px;
    border-top: 1px solid var(--ai-border);
    background-color: var(--ai-surface);
    flex-shrink: 0;
}
.quick-actions-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
}
.quick-action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 4px;
    background-color: var(--ai-surface);
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    cursor: pointer;
    font-size: 11px;
    color: var(--ai-text);
}
.quick-action-btn:hover {
    border-color: var(--ai-primary);
    background-color: var(--ai-primary-bg);
}
.quick-action-btn .material-symbols-outlined {
    font-size: 18px;
    color: var(--ai-primary);
}

/* Input Area */
.ai-input-area {
    padding: 12px 16px;
    border-top: 1px solid var(--ai-border);
    background-color: var(--ai-surface);
    flex-shrink: 0;
}
.ai-input-wrapper { display: flex; gap: 8px; }
.ai-input-wrapper textarea {
    flex: 1;
    padding: 10px 12px;
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    font-size: 14px;
    resize: none;
    font-family: inherit;
    max-height: 100px;
}
.ai-input-wrapper textarea:focus {
    outline: none;
    border-color: var(--ai-primary);
}
.ai-send-btn {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background-color: var(--ai-primary-light);
    color: white;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
}
.ai-send-btn:hover { opacity: 0.9; }
.ai-input-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    font-size: 11px;
    color: var(--ai-text-muted);
}

/* Full page content - shown when expanded */
.ai-full-content {
    display: none;
    flex: 1;
    overflow-y: auto;
}
.ai-overlay.expanded .ai-full-content {
    display: flex;
    flex-direction: row;
}
.ai-overlay.expanded .ai-messages-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--ai-border);
}
.ai-overlay.expanded .ai-messages-area .ai-messages {
    flex: 1;
    max-height: none;
}
.ai-session-sidebar {
    width: 280px;
    background: var(--ai-surface);
    display: none;
    flex-direction: column;
}
.ai-overlay.expanded .ai-session-sidebar {
    display: flex;
}
.sidebar-header {
    padding: 16px;
    border-bottom: 1px solid var(--ai-border);
    font-weight: 600;
    font-size: 14px;
    color: var(--ai-text);
}
.sidebar-search {
    padding: 12px 16px;
    border-bottom: 1px solid var(--ai-border);
}
.sidebar-search input {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--ai-border);
    border-radius: 6px;
    font-size: 13px;
}
.session-list {
    flex: 1;
    overflow-y: auto;
}
.session-item {
    padding: 12px 16px;
    border-bottom: 1px solid var(--ai-border);
    cursor: pointer;
    transition: background 0.2s;
}
.session-item:hover {
    background: var(--ai-surface-alt);
}
.session-item.active {
    background: var(--ai-primary-bg);
    border-left: 3px solid var(--ai-primary);
}
.session-item-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--ai-text);
    margin-bottom: 4px;
}
.session-item-preview {
    font-size: 12px;
    color: var(--ai-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.session-item-time {
    font-size: 11px;
    color: var(--ai-text-muted);
    margin-top: 4px;
}

/* Pulse / Stats section in expanded mode */
.ai-stats-section {
    padding: 16px;
    border-bottom: 1px solid var(--ai-border);
    display: none;
}
.ai-overlay.expanded .ai-stats-section {
    display: block;
}
.ai-stats-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--ai-text);
    margin-bottom: 12px;
}
.ai-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
}
.ai-stat-card {
    background: var(--ai-surface-alt);
    padding: 12px;
    border-radius: 8px;
    text-align: center;
}
.ai-stat-value {
    font-size: 20px;
    font-weight: 700;
    color: var(--ai-primary);
}
.ai-stat-label {
    font-size: 11px;
    color: var(--ai-text-muted);
}

/* Final opaque overlay override: never reveal native Moodle page behind panels. */
.ai-overlay,.ai-backdrop {
    background: #f7fbf3 !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
}
.ai-panel {
    background: rgba(255,255,255,.78) !important;
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
}
</style>

<script>
// ── Student Chat Panel — SSE Streaming (uses global window._umatStreamChat when available)
document.addEventListener('DOMContentLoaded', function() {
    var fab        = document.getElementById('ai-fab');
    var overlay    = document.getElementById('ai-overlay');
    var backdrop   = document.querySelector('.ai-backdrop');
    var closeBtn   = document.querySelector('.ai-close-btn');
    var expandBtn  = document.querySelector('.ai-expand-btn');
    var sendBtn    = document.querySelector('[data-region="send-btn"]');
    var input      = document.querySelector('[data-region="question-input"]');
    var quickBtns  = document.querySelectorAll('.quick-action-btn');
    var courseId   = {{courseid}} || 1;
    var sessionKey = 'cp_' + Math.random().toString(36).substr(2, 16);

    /* Derive stream URL from current Moodle root */
    var streamUrl  = (window.M && window.M.cfg ? window.M.cfg.wwwroot : '') + '/local/umat_ai/chat_stream.php';
    var moodleSesskey = (window.M && window.M.cfg ? window.M.cfg.sesskey : '');

    /* ── UI helpers ── */
    function getMsgsEl() { return document.querySelector('[data-region="messages"]'); }

    function appendUserMsg(text) {
        var c = getMsgsEl(); if (!c) return;
        var d = document.createElement('div');
        d.className = 'umat-msg-user';
        var esc = document.createElement('div');
        esc.appendChild(document.createTextNode(text));
        d.innerHTML = '<div class="umat-bubble-user"><p>' + esc.innerHTML + '</p></div>';
        c.appendChild(d);
        c.scrollTop = c.scrollHeight;
    }

    function appendAiMsg(html) {
        var c = getMsgsEl(); if (!c) return;
        var d = document.createElement('div');
        d.innerHTML = '<div class="umat-msg-ai"><div class="umat-msg-ai-ic"><span class="material-symbols-outlined">smart_toy</span></div>' +
            '<div class="umat-msg-ai-wrap"><div class="umat-msg-lbl">AI TUTOR</div>' +
            '<div class="umat-bubble-ai"><div class="umat-ai-content">' + html + '</div></div></div></div>';
        c.appendChild(d);
        c.scrollTop = c.scrollHeight;
    }

    function setDisabled(busy) {
        if (input)   { input.disabled = busy; }
        if (sendBtn) { sendBtn.disabled = busy; }
    }

    /* ── Main send function (SSE streaming) ── */
    function sendQuestion(question) {
        var c = getMsgsEl();
        if (!c || !question.trim()) return;

        appendUserMsg(question);
        if (input) input.value = '';
        setDisabled(true);

        /* Try SSE streaming first (requires chat_stream.php + browser fetch) */
        if (typeof window._umatStreamChat === 'function' && moodleSesskey) {
            window._umatStreamChat({
                url:         streamUrl,
                sesskey:     moodleSesskey,
                courseid:    courseId,
                question:    question,
                session_key: sessionKey,
                material_ids:[],
                msgsId:      c.id || _ensureMsgsId(c),
                onDone:  function() { setDisabled(false); },
                onError: function(payload) {
                    appendAiMsg('<p>⚠ ' + (payload.message || '{{#str}}error_ai, local_umat_ai{{/str}}') + '</p>');
                    setDisabled(false);
                }
            });
        } else {
            /* Fallback: legacy AJAX call */
            require(['core/ajax'], function(Ajax) {
                Ajax.call([{
                    methodname: 'local_umat_ai_ask_question',
                    args: { courseid: courseId, question: question }
                }])[0].done(function(response) {
                    appendAiMsg(response.success
                        ? '<p>' + (response.answer || '') + '</p>'
                        : '<p>{{#str}}error_ai, local_umat_ai{{/str}}</p>');
                    setDisabled(false);
                }).fail(function() {
                    appendAiMsg('<p>{{#str}}connection_error, local_umat_ai{{/str}}</p>');
                    setDisabled(false);
                });
            });
        }
    }

    function _ensureMsgsId(el) {
        if (!el.id) el.id = 'acp-msgs-' + Date.now();
        return el.id;
    }

    /* ── Overlay controls ── */
    function toggleExpand() {
        if (!overlay) return;
        overlay.classList.toggle('expanded');
        var icon = expandBtn && expandBtn.querySelector('.material-symbols-outlined');
        if (icon) icon.textContent = overlay.classList.contains('expanded') ? 'close_fullscreen' : 'open_in_full';
    }
    function openOverlay() {
        if (!overlay) return;
        overlay.classList.add('show');
        overlay.classList.remove('expanded');
        setTimeout(function() { if (input) input.focus(); }, 120);
    }
    function closeOverlay() {
        if (overlay) overlay.classList.remove('show', 'expanded');
    }

    /* ── Event bindings ── */
    if (fab)       fab.addEventListener('click', openOverlay);
    if (backdrop)  backdrop.addEventListener('click', closeOverlay);
    if (closeBtn)  closeBtn.addEventListener('click', closeOverlay);
    if (expandBtn) expandBtn.addEventListener('click', toggleExpand);
    if (sendBtn)   sendBtn.addEventListener('click', function() { if (input) sendQuestion(input.value); });
    if (input) {
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendQuestion(input.value); }
        });
        /* Auto-grow textarea */
        input.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
        });
    }
    quickBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            var queries = {
                'summarize':  '{{#str}}quick_summarize, local_umat_ai{{/str}}',
                'assignment': '{{#str}}quick_assignment, local_umat_ai{{/str}}',
                'explain':    '{{#str}}quick_explain, local_umat_ai{{/str}}',
                'deadlines':  '{{#str}}quick_deadlines, local_umat_ai{{/str}}'
            };
            var q = queries[btn.dataset.action];
            if (q) { if (input) input.value = q; sendQuestion(q); }
        });
    });
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay && overlay.classList.contains('show')) closeOverlay();
    });
});
</script>

