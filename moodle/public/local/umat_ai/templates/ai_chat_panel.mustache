{{!
    Template: local/umat_ai/templates/ai_chat_panel.mustache
    Renders the AI chat panel FAB + expandable overlay on any page.

    Uses CSS variables that inherit from theme or fall back to defaults.
    Works standalone or with any Moodle theme.

    Context variables:
    - courseid (int, optional) — for course-specific context
    - coursename (string, optional)
    - has_capability (bool) — whether user can use the chat
    - indexed (bool) — whether course materials are indexed
    - is_global (bool) — true if shown on non-course pages (enables expand)
}}

<!-- Material Symbols Font -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<style>
:root {
    --ai-primary: #006b2f;
    --ai-primary-dark: #005523;
    --ai-primary-light: #00873d;
    --ai-primary-bg: #eff6eb;
    --ai-surface: white;
    --ai-surface-alt: #f8f9fb;
    --ai-text: #1a1c19;
    --ai-text-muted: #6e7a6d;
    --ai-border: #dee5da;
    --ai-success: #4ade80;
    --ai-user-bubble: #dcfce7;
    --ai-user-text: #00210a;
    --ai-shadow: rgba(0,0,0,0.15);
    --ai-radius: 16px;
}

/* FAB Button */
.ai-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: var(--ai-primary) !important;
    color: white !important;
    border: none;
    box-shadow: 0 4px 12px var(--ai-shadow);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.ai-fab:hover {
    transform: scale(1.08);
    box-shadow: 0 8px 20px rgba(0,107,47,0.3);
}
.ai-fab .material-symbols-outlined {
    font-size: 28px;
}

/* Overlay */
.ai-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: flex-end;
    justify-content: flex-end;
}
@media (max-width: 768px) {
    .ai-overlay {
        align-items: center;
        justify-content: center;
    }
}
.ai-overlay.show { display: flex; }

/* Backdrop */
.ai-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0,0,0,0.3);
    backdrop-filter: blur(4px);
}

/* Panel - Collapsed (chat) */
.ai-panel {
    position: relative;
    width: 420px;
    max-width: 95vw;
    height: 70vh;
    max-height: 600px;
    background-color: var(--ai-surface);
    border-radius: var(--ai-radius);
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    margin: 16px;
    transition: width 0.3s ease, height 0.3s ease, max-height 0.3s ease, border-radius 0.3s ease;
}

/* Panel - Expanded (full page) */
.ai-overlay.expanded .ai-panel {
    width: 100vw;
    height: 100vh;
    max-height: 100vh;
    max-width: 100vw;
    margin: 0;
    border-radius: 0;
}

/* Panel Header */
.ai-panel-header {
    background: linear-gradient(135deg, var(--ai-primary) 0%, var(--ai-primary-light) 100%);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: white;
    flex-shrink: 0;
}
.ai-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
}
.ai-title {
    font-size: 16px;
    font-weight: 600;
}
.ai-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    opacity: 0.9;
}
.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--ai-success);
    animation: blink 2s infinite;
}
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
.ai-header-actions {
    margin-left: auto;
    display: flex;
    gap: 8px;
}
.ai-expand-btn {
    background: transparent;
    border: none;
    color: white;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    opacity: 0.8;
    transition: opacity 0.2s;
}
.ai-expand-btn:hover { opacity: 1; }
.ai-expand-btn .material-symbols-outlined {
    font-size: 20px;
}
.ai-close-btn {
    background: transparent;
    border: none;
    color: white;
    cursor: pointer;
    padding: 4px;
}

/* Chat Messages */
.ai-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    background-color: var(--ai-surface-alt);
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.chat-message { display: flex; max-width: 85%; }
.chat-message.ai { align-self: flex-start; }
.chat-message.user { align-self: flex-end; }
.chat-bubble {
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.5;
}
.chat-message.ai .chat-bubble {
    background-color: var(--ai-surface);
    border-left: 3px solid var(--ai-primary);
}
.chat-message.user .chat-bubble {
    background-color: var(--ai-user-bubble);
    color: var(--ai-user-text);
}

/* Quick Actions */
.ai-quick-actions {
    padding: 12px 16px;
    border-top: 1px solid var(--ai-border);
    background-color: var(--ai-surface);
    flex-shrink: 0;
}
.quick-actions-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
}
.quick-action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 4px;
    background-color: var(--ai-surface);
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    cursor: pointer;
    font-size: 11px;
    color: var(--ai-text);
}
.quick-action-btn:hover {
    border-color: var(--ai-primary);
    background-color: var(--ai-primary-bg);
}
.quick-action-btn .material-symbols-outlined {
    font-size: 18px;
    color: var(--ai-primary);
}

/* Input Area */
.ai-input-area {
    padding: 12px 16px;
    border-top: 1px solid var(--ai-border);
    background-color: var(--ai-surface);
    flex-shrink: 0;
}
.ai-input-wrapper { display: flex; gap: 8px; }
.ai-input-wrapper textarea {
    flex: 1;
    padding: 10px 12px;
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    font-size: 14px;
    resize: none;
    font-family: inherit;
    max-height: 100px;
}
.ai-input-wrapper textarea:focus {
    outline: none;
    border-color: var(--ai-primary);
}
.ai-send-btn {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background-color: var(--ai-primary-light);
    color: white;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
}
.ai-send-btn:hover { opacity: 0.9; }
.ai-input-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    font-size: 11px;
    color: var(--ai-text-muted);
}

/* Full page content - shown when expanded */
.ai-full-content {
    display: none;
    flex: 1;
    overflow-y: auto;
}
.ai-overlay.expanded .ai-full-content {
    display: flex;
    flex-direction: row;
}
.ai-overlay.expanded .ai-messages-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--ai-border);
}
.ai-overlay.expanded .ai-messages-area .ai-messages {
    flex: 1;
    max-height: none;
}
.ai-session-sidebar {
    width: 280px;
    background: var(--ai-surface);
    display: none;
    flex-direction: column;
}
.ai-overlay.expanded .ai-session-sidebar {
    display: flex;
}
.sidebar-header {
    padding: 16px;
    border-bottom: 1px solid var(--ai-border);
    font-weight: 600;
    font-size: 14px;
    color: var(--ai-text);
}
.sidebar-search {
    padding: 12px 16px;
    border-bottom: 1px solid var(--ai-border);
}
.sidebar-search input {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--ai-border);
    border-radius: 6px;
    font-size: 13px;
}
.session-list {
    flex: 1;
    overflow-y: auto;
}
.session-item {
    padding: 12px 16px;
    border-bottom: 1px solid var(--ai-border);
    cursor: pointer;
    transition: background 0.2s;
}
.session-item:hover {
    background: var(--ai-surface-alt);
}
.session-item.active {
    background: var(--ai-primary-bg);
    border-left: 3px solid var(--ai-primary);
}
.session-item-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--ai-text);
    margin-bottom: 4px;
}
.session-item-preview {
    font-size: 12px;
    color: var(--ai-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.session-item-time {
    font-size: 11px;
    color: var(--ai-text-muted);
    margin-top: 4px;
}

/* Pulse / Stats section in expanded mode */
.ai-stats-section {
    padding: 16px;
    border-bottom: 1px solid var(--ai-border);
    display: none;
}
.ai-overlay.expanded .ai-stats-section {
    display: block;
}
.ai-stats-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--ai-text);
    margin-bottom: 12px;
}
.ai-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
}
.ai-stat-card {
    background: var(--ai-surface-alt);
    padding: 12px;
    border-radius: 8px;
    text-align: center;
}
.ai-stat-value {
    font-size: 20px;
    font-weight: 700;
    color: var(--ai-primary);
}
.ai-stat-label {
    font-size: 11px;
    color: var(--ai-text-muted);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var fab = document.getElementById('ai-fab');
    var overlay = document.getElementById('ai-overlay');
    var backdrop = document.querySelector('.ai-backdrop');
    var closeBtn = document.querySelector('.ai-close-btn');
    var expandBtn = document.querySelector('.ai-expand-btn');
    var sendBtn = document.querySelector('[data-region="send-btn"]');
    var input = document.querySelector('[data-region="question-input"]');
    var quickBtns = document.querySelectorAll('.quick-action-btn');

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(text));
        return div.innerHTML;
    }

    function addMessage(text, isUser) {
        var messagesContainer = document.querySelector('[data-region="messages"]');
        if (!messagesContainer) return;

        var msgDiv = document.createElement('div');
        msgDiv.className = 'chat-message ' + (isUser ? 'user' : 'ai');
        msgDiv.innerHTML = '<div class="chat-bubble"><p>' + escapeHtml(text) + '</p></div>';
        messagesContainer.appendChild(msgDiv);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function toggleExpand() {
        if (overlay) {
            overlay.classList.toggle('expanded');
            if (overlay.classList.contains('expanded')) {
                if (expandBtn) {
                    var icon = expandBtn.querySelector('.material-symbols-outlined');
                    if (icon) icon.textContent = 'close_fullscreen';
                }
            } else {
                if (expandBtn) {
                    var icon = expandBtn.querySelector('.material-symbols-outlined');
                    if (icon) icon.textContent = 'open_in_full';
                }
            }
        }
    }

    function openOverlay() {
        if (overlay) {
            overlay.classList.add('show');
            overlay.classList.remove('expanded');
            setTimeout(function() {
                if (input) input.focus();
            }, 100);
        }
    }

    function closeOverlay() {
        if (overlay) {
            overlay.classList.remove('show', 'expanded');
        }
    }

    function sendQuestion(question) {
        var messagesContainer = document.querySelector('[data-region="messages"]');
        if (!messagesContainer || !question.trim()) return;

        addMessage(question, true);
        if (input) input.value = '';

        var typing = document.createElement('div');
        typing.className = 'chat-message ai';
        typing.id = 'typing-indicator';
        typing.innerHTML = '<div class="chat-bubble"><p><em>{{#str}}ai_thinking, local_umat_ai{{/str}}</em></p></div>';
        messagesContainer.appendChild(typing);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        var courseId = {{courseid}} || 1;

        require(['core/ajax'], function(Ajax) {
            Ajax.call([{
                methodname: 'local_umat_ai_ask_question',
                args: {
                    courseid: courseId,
                    question: question
                }
            }])[0].done(function(response) {
                var indicator = document.getElementById('typing-indicator');
                if (indicator) indicator.remove();

                if (response.success) {
                    addMessage(response.answer, false);
                } else {
                    addMessage('{{#str}}error_ai, local_umat_ai{{/str}}', false);
                }
            }).fail(function() {
                var indicator = document.getElementById('typing-indicator');
                if (indicator) indicator.remove();
                addMessage('{{#str}}connection_error, local_umat_ai{{/str}}', false);
            });
        });
    }

    // Event listeners
    if (fab) {
        fab.addEventListener('click', openOverlay);
    }

    if (backdrop) {
        backdrop.addEventListener('click', closeOverlay);
    }

    if (closeBtn) {
        closeBtn.addEventListener('click', closeOverlay);
    }

    if (expandBtn) {
        expandBtn.addEventListener('click', toggleExpand);
    }

    if (sendBtn) {
        sendBtn.addEventListener('click', function() {
            if (input) sendQuestion(input.value);
        });
    }

    if (input) {
        input.addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendQuestion(input.value);
            }
        });
    }

    quickBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            var action = btn.dataset.action;
            var questions = {
                'summarize': '{{#str}}quick_summarize, local_umat_ai{{/str}}',
                'assignment': '{{#str}}quick_assignment, local_umat_ai{{/str}}',
                'explain': '{{#str}}quick_explain, local_umat_ai{{/str}}',
                'deadlines': '{{#str}}quick_deadlines, local_umat_ai{{/str}}'
            };
            if (questions[action] && input) {
                input.value = questions[action];
            }
        });
    });

    // ESC key to close
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay && overlay.classList.contains('show')) {
            closeOverlay();
        }
    });
});
</script>

{{#has_capability}}
<button
    class="ai-fab"
    id="ai-fab"
    aria-label="{{#str}}chatpanel_tooltip, local_umat_ai{{/str}}"
>
    <span class="material-symbols-outlined">smart_toy</span>
</button>

<div class="ai-overlay" id="ai-overlay">
    <div class="ai-backdrop"></div>

    <div class="ai-panel" role="dialog" aria-modal="true" aria-labelledby="ai-panel-title">
        <div class="ai-panel-header">
            <div class="ai-avatar">
                <span class="material-symbols-outlined">smart_toy</span>
            </div>
            <div>
                <div class="ai-title" id="ai-panel-title">{{#str}}chatpanel_title, local_umat_ai{{/str}}</div>
                <div class="ai-status">
                    <span class="status-dot"></span>
                    {{#str}}ai_online, local_umat_ai{{/str}}
                </div>
            </div>
            <div class="ai-header-actions">
                {{#is_global}}
                <button class="ai-expand-btn" aria-label="{{#str}}expand, local_umat_ai{{/str}}">
                    <span class="material-symbols-outlined">open_in_full</span>
                </button>
                {{/is_global}}
                <button class="ai-close-btn" aria-label="{{#str}}close, local_umat_ai{{/str}}">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
        </div>

        <!-- Stats Section (shown when expanded) -->
        <div class="ai-stats-section">
            <div class="ai-stats-title">{{#str}}learning_pulse, local_umat_ai{{/str}}</div>
            <div class="ai-stats-grid">
                <div class="ai-stat-card">
                    <div class="ai-stat-value">12</div>
                    <div class="ai-stat-label">{{#str}}sessions_this_week, local_umat_ai{{/str}}</div>
                </div>
                <div class="ai-stat-card">
                    <div class="ai-stat-value">47</div>
                    <div class="ai-stat-label">{{#str}}questions_asked, local_umat_ai{{/str}}</div>
                </div>
            </div>
        </div>

        <div class="ai-full-content">
            <div class="ai-session-sidebar">
                <div class="sidebar-header">{{#str}}recent_sessions, local_umat_ai{{/str}}</div>
                <div class="sidebar-search">
                    <input type="text" placeholder="{{#str}}search_sessions, local_umat_ai{{/str}}" />
                </div>
                <div class="session-list">
                    <div class="session-item">
                        <div class="session-item-title">EL 452 - Solar Energy</div>
                        <div class="session-item-preview">Discussed PV cell efficiency...</div>
                        <div class="session-item-time">2 hours ago</div>
                    </div>
                    <div class="session-item">
                        <div class="session-item-title">CS 301 - Algorithms</div>
                        <div class="session-item-preview">Binary tree traversal methods...</div>
                        <div class="session-item-time">Yesterday</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ai-messages-area">
            <div class="ai-messages" data-region="messages">
                <div class="chat-message ai">
                    <div class="chat-bubble">
                        <p>{{#str}}ai_greeting, local_umat_ai{{/str}}</p>
                    </div>
                </div>
            </div>

            <div class="ai-quick-actions">
                <div class="quick-actions-grid">
                    <button class="quick-action-btn" data-action="summarize">
                        <span class="material-symbols-outlined">summarize</span>
                        <span>{{#str}}action_summarize, local_umat_ai{{/str}}</span>
                    </button>
                    <button class="quick-action-btn" data-action="assignment">
                        <span class="material-symbols-outlined">assignment</span>
                        <span>{{#str}}action_assignment, local_umat_ai{{/str}}</span>
                    </button>
                    <button class="quick-action-btn" data-action="explain">
                        <span class="material-symbols-outlined">lightbulb</span>
                        <span>{{#str}}action_explain, local_umat_ai{{/str}}</span>
                    </button>
                    <button class="quick-action-btn" data-action="deadlines">
                        <span class="material-symbols-outlined">event</span>
                        <span>{{#str}}action_deadlines, local_umat_ai{{/str}}</span>
                    </button>
                </div>
            </div>

            <div class="ai-input-area">
                <div class="ai-input-wrapper">
                    <textarea
                        data-region="question-input"
                        placeholder="{{#str}}ask_placeholder, local_umat_ai{{/str}}"
                        rows="2"
                        maxlength="500"
                    ></textarea>
                    <button class="ai-send-btn" data-region="send-btn" aria-label="{{#str}}send, local_umat_ai{{/str}}">
                        <span class="material-symbols-outlined">send</span>
                    </button>
                </div>
                <div class="ai-input-footer">
                    <span>{{#str}}ai_disclaimer, local_umat_ai{{/str}}</span>
                    {{#is_global}}
                    <a href="{{wwwroot}}/local/umat_ai/hub.php" style="color: var(--ai-primary); font-size: 11px;">{{#str}}open_hub, local_umat_ai{{/str}}</a>
                    {{/is_global}}
                </div>
            </div>
        </div>
    </div>
</div>
{{/has_capability}}

{{^has_capability}}
<button
    class="ai-fab"
    id="ai-fab"
    aria-label="{{#str}}chatpanel_title, local_umat_ai{{/str}}"
    disabled
    style="opacity: 0.5; cursor: not-allowed;"
>
    <span class="material-symbols-outlined">smart_toy</span>
</button>
{{/has_capability}}