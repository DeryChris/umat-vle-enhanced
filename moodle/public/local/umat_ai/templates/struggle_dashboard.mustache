{{!
    Template: local/umat_ai/templates/struggle_dashboard.mustache
    Student Struggle Areas Dashboard — full spec layout.
    Context: courseid, coursefullname
    Rendered via JS AMD module struggle_dashboard.init(courseid)
}}
<div class="sd-dashboard" data-stream-url="{{stream_url}}" data-sesskey="{{sesskey}}">

  <!-- Claude-style NLQ bar -->
  <div class="sd-nlq-wrap">
    <div class="sd-nlq-bar">
      <span class="material-symbols-outlined sd-nlq-icon">auto_awesome</span>
      <input type="text" id="sd-nlq-input" class="sd-nlq-input"
        placeholder="Ask AI: Show me students struggling with thermodynamics…" maxlength="500" />
      <button class="sd-nlq-btn" id="sd-nlq-btn" type="button" aria-label="Ask AI">
        <span class="material-symbols-outlined">arrow_upward</span>
      </button>
    </div>
    <div id="sd-nlq-response" class="sd-nlq-response umat-ai-stream-panel" style="display:none;"></div>
  </div>

  <!-- ================================================================ -->
  <!-- TOP KPI RIBBON — 4 columns                                       -->
  <!-- ================================================================ -->
  <div class="sd-kpi-ribbon">
    <div class="sd-kpi-card" id="sd-kpi-engagement">
      <div class="sd-kpi-header">Class Engagement Score</div>
      <div class="sd-kpi-body">
        <span class="sd-kpi-big" id="sd-eng-pct">0%</span>
        <canvas id="sd-eng-sparkline" width="120" height="40"></canvas>
      </div>
      <div class="sd-kpi-delta positive" id="sd-eng-delta">+ 0% vs. Last Week</div>
    </div>

    <div class="sd-kpi-card" id="sd-kpi-atrisk">
      <div class="sd-kpi-header">
        <span class="material-symbols-outlined sd-warn-icon">priority_high</span>
        Total At-Risk Students
      </div>
      <div class="sd-kpi-body">
        <span class="sd-kpi-big sd-risk-num" id="sd-atrisk-count">0</span>
      </div>
      <div class="sd-avatar-stack" id="sd-atrisk-avatars"></div>
    </div>

    <div class="sd-kpi-card" id="sd-kpi-topic">
      <div class="sd-kpi-header">Top Difficulty Topic</div>
      <div class="sd-kpi-body">
        <div class="sd-gauge-wrap">
          <canvas id="sd-topic-gauge" width="80" height="60"></canvas>
          <span class="sd-gauge-label" id="sd-topic-name">—</span>
        </div>
      </div>
      <div class="sd-kpi-insight" id="sd-topic-insight"></div>
    </div>

    <div class="sd-kpi-card" id="sd-kpi-material">
      <div class="sd-kpi-header">
        <span class="material-symbols-outlined sd-warn-icon">warning</span>
        Material with Highest Friction
      </div>
      <div class="sd-kpi-body">
        <div class="sd-mat-name" id="sd-mat-name">—</div>
        <canvas id="sd-mat-weekday-chart" width="140" height="40"></canvas>
      </div>
    </div>
  </div>

  <!-- ================================================================ -->
  <!-- MIDDLE SECTION — 2 columns: Scatter Plot + Topic Mastery         -->
  <!-- ================================================================ -->
  <div class="sd-mid-row">
    <div class="sd-card sd-card-half">
      <div class="sd-card-header">Struggle Friction Analysis</div>
      <div class="sd-chart-container">
        <canvas id="sd-scatter-plot"></canvas>
      </div>
    </div>
    <div class="sd-card sd-card-half">
      <div class="sd-card-header">Topic Mastery &amp; Support</div>
      <div class="sd-topic-mastery-list" id="sd-topic-mastery-list">
        <div class="sd-empty">No topic data yet.</div>
      </div>
    </div>
  </div>

  <!-- ================================================================ -->
  <!-- BOTTOM SECTION — 2 columns: Student Triage + Material Health     -->
  <!-- ================================================================ -->
  <div class="sd-bot-row">
    <div class="sd-card sd-card-half">
      <div class="sd-card-header">Actionable At-Risk Student Triage</div>
      <div class="sd-table-wrap">
        <table class="sd-data-table" id="sd-student-table">
          <thead>
            <tr>
              <th><input type="checkbox" id="sd-select-all"></th>
              <th class="sd-sortable" data-col="name">Name <span class="sd-sort-icon"></span></th>
              <th class="sd-sortable" data-col="risk">Risk Status <span class="sd-sort-icon"></span></th>
              <th class="sd-sortable" data-col="struggle">Primary Struggle <span class="sd-sort-icon"></span></th>
              <th class="sd-sortable" data-col="last">Last Activity <span class="sd-sort-icon"></span></th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="sd-student-tbody">
            <tr><td colspan="6" class="sd-empty">No at-risk students.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="sd-card sd-card-half">
      <div class="sd-card-header">Material &amp; Content Health</div>
      <div class="sd-chart-container">
        <canvas id="sd-material-health-chart"></canvas>
      </div>
    </div>
  </div>

  <!-- ================================================================ -->
  <!-- FOOTER — Questions Feed + Topics + AI Health Report               -->
  <!-- ================================================================ -->
  <div class="sd-footer-row">
    <div class="sd-card sd-card-third">
      <div class="sd-card-header">Common Student Questions</div>
      <div class="sd-questions-feed" id="sd-questions-feed">
        <div class="sd-empty">No questions yet.</div>
      </div>
    </div>
    <div class="sd-card sd-card-third">
      <div class="sd-card-header">Topics by Frequency</div>
      <div class="sd-topics-feed" id="sd-topics-feed">
        <div class="sd-empty">No topics yet.</div>
      </div>
    </div>
    <div class="sd-card sd-card-full">
      <div class="sd-card-header">
        AI Course Health Report
        <button class="sd-btn-outline" id="sd-ai-strategy-btn">
          <span class="material-symbols-outlined">auto_awesome</span>
          Ask AI for tailored student outreach strategies
        </button>
      </div>
      <div class="sd-health-report" id="sd-health-report">
        <div class="sd-empty">Loading health report…</div>
      </div>
      <div class="sd-recommendations" id="sd-recommendations"></div>
    </div>
  </div>

  <!-- Shimmer skeleton for loading state -->
  <div class="sd-skeleton" id="sd-skeleton">
    <div class="sd-shim-row"><div class="sd-shim-block" style="width:23%;height:120px;"></div><div class="sd-shim-block" style="width:23%;height:120px;"></div><div class="sd-shim-block" style="width:23%;height:120px;"></div><div class="sd-shim-block" style="width:23%;height:120px;"></div></div>
    <div class="sd-shim-row"><div class="sd-shim-block" style="width:49%;height:300px;"></div><div class="sd-shim-block" style="width:49%;height:300px;"></div></div>
    <div class="sd-shim-row"><div class="sd-shim-block" style="width:49%;height:260px;"></div><div class="sd-shim-block" style="width:49%;height:260px;"></div></div>
    <div class="sd-shim-row"><div class="sd-shim-block" style="width:32%;height:200px;"></div><div class="sd-shim-block" style="width:32%;height:200px;"></div><div class="sd-shim-block" style="width:32%;height:200px;"></div></div>
  </div>
</div>
