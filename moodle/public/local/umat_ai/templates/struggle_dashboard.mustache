{{!
    Template: local/umat_ai/templates/struggle_dashboard.mustache
    Lecturer Insights Dashboard — 5-zone actionable insights layout.
    Context: stream_url, sesskey
    Rendered via JS AMD module struggle_dashboard.init(courseid)
}}
<div class="umat-insights-pane sd-dashboard" data-stream-url="{{stream_url}}" data-sesskey="{{sesskey}}">

  <!-- ZONE 1: Priority Briefing -->
  <section class="ins-zone" id="ins-priority-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">notification_important</span>
      What Needs Your Attention
    </h3>
    <div id="ins-priority-actions" class="ins-priority-list"></div>
  </section>

  <!-- ZONE 2: Struggle Map -->
  <section class="ins-zone" id="ins-struggle-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">map</span>
      Where Students Are Struggling
    </h3>
    <div id="ins-struggle-areas" class="ins-struggle-list"></div>
    <div id="ins-section-breakdown" class="ins-section-bars"></div>
    <div id="ins-material-struggle" class="ins-material-list"></div>
  </section>

  <!-- ZONE 3: Student Dossiers -->
  <section class="ins-zone" id="ins-students-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">groups</span>
      Your Students
    </h3>
    <div class="ins-nlq-bar">
      <input type="text" id="ins-nlq-input" class="ins-nlq-input"
        placeholder="Ask about student performance..." />
      <button class="ins-nlq-btn" onclick="window.struggleDashboard.submitNLQ()">
        <span class="material-symbols-outlined">search</span>
      </button>
      <div class="ins-nlq-spinner" id="ins-nlq-spinner" style="display:none;"></div>
    </div>
    <div id="ins-nlq-response" class="ins-nlq-response umat-ai-stream-panel" style="display:none;"></div>
    <div class="ins-filter-row" id="ins-filters">
      <button class="ins-chip ins-chip-active" data-filter="all" onclick="window.struggleDashboard.setFilter('all', this)">All</button>
      <button class="ins-chip" data-filter="disengaged" onclick="window.struggleDashboard.setFilter('disengaged', this)">
        <span class="material-symbols-outlined">person_off</span> Disengaged
      </button>
      <button class="ins-chip" data-filter="struggling" onclick="window.struggleDashboard.setFilter('struggling', this)">
        <span class="material-symbols-outlined">psychology</span> Struggling
      </button>
      <button class="ins-chip" data-filter="failing" onclick="window.struggleDashboard.setFilter('failing', this)">
        <span class="material-symbols-outlined">trending_down</span> Failing
      </button>
      <button class="ins-chip" data-filter="issues" onclick="window.struggleDashboard.setFilter('issues', this)">
        <span class="material-symbols-outlined">report</span> Issues
      </button>
    </div>
    <div id="ins-student-list" class="ins-student-cards">
      <div class="ins-empty">No student data loaded yet.</div>
    </div>
  </section>

  <!-- ZONE 4: Question Radar -->
  <section class="ins-zone" id="ins-questions-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">question_answer</span>
      What Students Are Asking
    </h3>
    <div id="ins-common-questions" class="ins-question-list"></div>
  </section>

  <!-- ZONE 5: Course Vitals -->
  <section class="ins-zone" id="ins-vitals-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">monitor_heart</span>
      Course Pulse
    </h3>
    <div id="ins-course-pulse" class="ins-pulse-grid"></div>
  </section>

  <!-- Student Detail Panel -->
  <div class="ins-detail-panel" id="ins-detail-panel" style="display:none;">
    <div class="ins-detail-header">
      <div>
        <strong id="ins-detail-name">-</strong>
        <span class="ins-pill" id="ins-detail-risk-badge">-</span>
      </div>
      <button class="ins-chip-sm" onclick="window.struggleDashboard.closeDetail()">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <div class="ins-detail-body" id="ins-detail-body">
      <div class="ins-empty">Loading profile...</div>
    </div>
    <div class="ins-detail-actions">
      <button class="ins-action-btn" onclick="window.struggleDashboard.openActionDrawer('encouragement')">
        <span class="material-symbols-outlined">favorite</span> Encourage
      </button>
      <button class="ins-action-btn" onclick="window.struggleDashboard.openActionDrawer('meeting')">
        <span class="material-symbols-outlined">event</span> 1:1
      </button>
      <button class="ins-action-btn" onclick="window.struggleDashboard.openActionDrawer('remedial_quiz')">
        <span class="material-symbols-outlined">quiz</span> Quiz
      </button>
    </div>
  </div>

  <!-- Action Drawer -->
  <div class="ins-action-drawer" id="ins-action-drawer" style="display:none;">
    <div class="ins-drawer-backdrop" onclick="window.struggleDashboard.closeActionDrawer()"></div>
    <div class="ins-drawer-content">
      <div class="ins-drawer-header">
        <h3 id="ins-drawer-title">Send Intervention</h3>
        <button class="ins-chip-sm" onclick="window.struggleDashboard.closeActionDrawer()">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="ins-drawer-body">
        <p id="ins-drawer-recipient" style="font-size:13px;color:var(--u-ol);margin:0 0 12px;"></p>
        <textarea id="ins-drawer-message" class="ins-drawer-textarea"
          placeholder="Draft your message..." rows="4"></textarea>
        <div id="ins-drawer-status" style="font-size:12px;margin-top:8px;display:none;"></div>
      </div>
      <div class="ins-drawer-footer">
        <button class="ins-btn ins-btn-secondary" onclick="window.struggleDashboard.closeActionDrawer()">Cancel</button>
        <button class="ins-btn ins-btn-primary" id="ins-drawer-send-btn" onclick="window.struggleDashboard.sendIntervention()">
          <span class="material-symbols-outlined">send</span> Send
        </button>
      </div>
    </div>
  </div>

  <!-- Skeleton -->
  <div class="ins-skeleton" id="ins-skeleton" style="display:none;">
    <div class="ins-shimmer-block" style="width:100%;height:80px;"></div>
    <div class="ins-shimmer-block" style="width:100%;height:120px;"></div>
    <div class="ins-shimmer-block" style="width:100%;height:200px;"></div>
    <div class="ins-shimmer-block" style="width:100%;height:150px;"></div>
  </div>
</div>
