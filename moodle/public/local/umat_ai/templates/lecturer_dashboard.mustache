{{!
    Template: local/umat_ai/templates/lecturer_dashboard.mustache
    Lecturer Analytics Dashboard — full-page view.

    Context:
      courseid, coursefullname, shortname
      enrolled_students, active_students, active_pct
      total_interactions, pending_approvals, struggle_index
      avg_qps, high_performers, on_track, at_risk
      daily_counts (array: label, count)
      daily_counts_json (string, for JS chart)
      max_count (int)
      top_questions (array: text, ask_count)
      approve_url, hub_url, wwwroot
      has_pending (bool), has_questions (bool)
}}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200">

<style>
/* ---- UMaT Precision Green tokens ---- */
:root {
  --p:   #006b2f; --pb: #00873d; --op: #ffffff;
  --sf:  #f5fbf0; --sfl: #eff6eb; --sflo: #ffffff;
  --ons: #171d17; --onsv: #3e4a3e;
  --ol:  #6e7a6d; --olv: #bdcaba;
  --sec: #3d6844; --secc: #beefc1;
  --ter: #a5304d; --err: #ba1a1a;
  --r8:  8px; --r12: 12px; --r16: 16px; --r20: 20px;
}

.umat-dash-wrap {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  max-width: 1280px;
  margin: 0 auto;
  padding: 24px 20px 60px;
  color: var(--ons);
}

/* ---- Topbar ---- */
.umat-dash-topbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 28px;
  flex-wrap: wrap;
}
.umat-dash-topbar h1 {
  margin: 0 0 4px;
  font-size: 26px;
  font-weight: 800;
  color: var(--p);
  line-height: 1.1;
}
.umat-dash-topbar p {
  margin: 0;
  font-size: 13px;
  color: var(--onsv);
}
.umat-topbar-actions { display: flex; gap: 10px; flex-wrap: wrap; }
.umat-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 9px 18px;
  border-radius: var(--r8);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  border: none;
  text-decoration: none;
  transition: all .2s;
  font-family: inherit;
}
.umat-btn .material-symbols-outlined { font-size: 17px; }
.umat-btn-primary { background: var(--p); color: var(--op); }
.umat-btn-primary:hover { background: var(--pb); }
.umat-btn-outline { background: var(--sflo); border: 1.5px solid var(--olv); color: var(--ons); }
.umat-btn-outline:hover { border-color: var(--p); color: var(--p); }
.umat-btn-warn { background: #fef3c7; color: #92400e; border: 1.5px solid #fcd34d; }
.umat-btn-warn:hover { background: #fde68a; }

/* ---- Badge pill ---- */
.umat-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}
.pill-ok   { background: #dcfce7; color: #065f46; }
.pill-warn { background: #fef3c7; color: #78350f; }
.pill-high { background: #fee2e2; color: #991b1b; }
.pill-info { background: var(--secc); color: var(--sec); }
.pill-blue { background: #dbeafe; color: #1e40af; }

/* ---- KPI grid (4 cols desktop, 2 mobile) ---- */
.umat-kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 28px;
}
@media (max-width: 900px) { .umat-kpi-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 500px) { .umat-kpi-grid { grid-template-columns: 1fr; } }

.umat-kpi-card {
  background: var(--sflo);
  border: 1px solid var(--olv);
  border-radius: var(--r12);
  padding: 18px;
  box-shadow: 0 2px 8px rgba(0,0,0,.04);
}
.umat-kpi-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.umat-kpi-icon {
  width: 36px; height: 36px;
  border-radius: var(--r8);
  display: flex;
  align-items: center;
  justify-content: center;
}
.umat-kpi-icon .material-symbols-outlined { font-size: 20px; }
.kpi-icon-green  { background: rgba(0,107,47,.1);  color: var(--p); }
.kpi-icon-sec    { background: rgba(61,104,68,.1); color: var(--sec); }
.kpi-icon-warn   { background: rgba(245,158,11,.1); color: #d97706; }
.kpi-icon-err    { background: rgba(165,48,77,.1);  color: var(--ter); }
.umat-kpi-val {
  font-size: 32px;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 4px;
  color: var(--ons);
}
.umat-kpi-label { font-size: 12px; color: var(--ol); margin-bottom: 6px; }

/* ---- Two-column main layout ---- */
.umat-dash-main {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
  margin-bottom: 24px;
}
@media (max-width: 900px) { .umat-dash-main { grid-template-columns: 1fr; } }

/* ---- Card base ---- */
.umat-card {
  background: var(--sflo);
  border: 1px solid var(--olv);
  border-radius: var(--r16);
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(0,0,0,.05);
}
.umat-card-header {
  padding: 16px 20px;
  border-bottom: 1px solid var(--olv);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.umat-card-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--ons);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 7px;
}
.umat-card-title .material-symbols-outlined { font-size: 18px; color: var(--p); }
.umat-card-body { padding: 20px; }

/* ---- Bar chart ---- */
.umat-chart {
  height: 200px;
  display: flex;
  align-items: flex-end;
  gap: 6px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--olv);
  position: relative;
}
.umat-bar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  height: 100%;
  justify-content: flex-end;
  gap: 4px;
  position: relative;
}
.umat-bar {
  width: 100%;
  border-radius: 4px 4px 0 0;
  background: var(--p);
  min-height: 2px;
  transition: height .4s ease;
  cursor: default;
  position: relative;
}
.umat-bar::after {
  content: attr(data-count);
  position: absolute;
  top: -18px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 10px;
  color: var(--ol);
  white-space: nowrap;
  opacity: 0;
  transition: opacity .2s;
}
.umat-bar:hover::after { opacity: 1; }
.umat-bar-label { font-size: 10px; color: var(--ol); white-space: nowrap; }

/* ---- Performance breakdown ---- */
.umat-perf-item { margin-bottom: 14px; }
.umat-perf-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 5px;
}
.umat-perf-label { font-size: 13px; color: var(--ons); font-weight: 500; }
.umat-perf-num   { font-size: 13px; color: var(--ol); }
.umat-perf-bar {
  height: 8px;
  border-radius: 4px;
  background: var(--sfl);
  overflow: hidden;
}
.umat-perf-bar-fill { height: 100%; border-radius: 4px; }
.fill-high  { background: var(--p); }
.fill-track { background: #60a5fa; }
.fill-risk  { background: var(--ter); }

/* ---- AI insight card ---- */
.umat-insight-big {
  border: 1px solid var(--olv);
  border-radius: var(--r12);
  padding: 16px;
  margin-bottom: 12px;
  background: var(--sflo);
}
.umat-insight-big.warn { border-left: 4px solid var(--ter); }
.umat-insight-big.alert { border-left: 4px solid #f59e0b; }
.umat-insight-big.info  { border-left: 4px solid var(--p); }
.umat-insight-big h4 {
  margin: 0 0 6px;
  font-size: 14px;
  font-weight: 700;
  color: var(--ons);
  display: flex;
  align-items: center;
  gap: 6px;
}
.umat-insight-big h4 .material-symbols-outlined { font-size: 18px; }
.umat-insight-big p { margin: 0 0 10px; font-size: 13px; color: var(--onsv); line-height: 1.5; }
.umat-insight-big .umat-insight-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.umat-insight-chip-btn {
  padding: 5px 13px;
  border-radius: 999px;
  border: 1.5px solid var(--p);
  background: none;
  color: var(--p);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all .2s;
  font-family: inherit;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.umat-insight-chip-btn .material-symbols-outlined { font-size: 14px; }
.umat-insight-chip-btn:hover { background: var(--p); color: var(--op); }

/* ---- Questions table ---- */
.umat-q-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.umat-q-table th {
  text-align: left;
  padding: 8px 12px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .05em;
  color: var(--ol);
  border-bottom: 1px solid var(--olv);
}
.umat-q-table td { padding: 10px 12px; border-bottom: 1px solid var(--sfl); vertical-align: top; }
.umat-q-table tr:last-child td { border-bottom: none; }
.umat-q-table tr:hover td { background: var(--sfl); }
.q-count-chip {
  display: inline-flex;
  align-items: center;
  padding: 2px 9px;
  border-radius: 999px;
  background: var(--secc);
  color: var(--sec);
  font-size: 11px;
  font-weight: 700;
}

/* ---- Heatmap ---- */
.umat-heatmap {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
}
.umat-heat-cell {
  aspect-ratio: 1;
  border-radius: 4px;
  background: var(--sfl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  color: var(--ol);
  cursor: default;
  transition: transform .15s;
  position: relative;
}
.umat-heat-cell:hover { transform: scale(1.15); }
.umat-heat-label { font-size: 10px; color: var(--ol); text-align: center; }

/* ---- Divider ---- */
.umat-section-divider {
  height: 1px;
  background: var(--olv);
  margin: 28px 0;
}

/* ---- Empty state ---- */
.umat-empty {
  text-align: center;
  padding: 32px;
  color: var(--ol);
}
.umat-empty .material-symbols-outlined { font-size: 48px; color: var(--olv); display: block; margin-bottom: 10px; }
.umat-empty p { font-size: 13px; margin: 0; }
</style>

<div class="umat-dash-wrap">

  <!-- ================================================================ -->
  <!-- Top bar                                                           -->
  <!-- ================================================================ -->
  <div class="umat-dash-topbar">
    <div>
      <h1>{{#str}}analytics_dashboard_title, local_umat_ai{{/str}}</h1>
      <p>{{coursefullname}} &nbsp;·&nbsp; Past 30 Days</p>
    </div>
    <div class="umat-topbar-actions">
      {{#has_pending}}
      <a href="{{approve_url}}" class="umat-btn umat-btn-warn">
        <span class="material-symbols-outlined">fact_check</span>
        Review AI Outputs ({{pending_approvals}})
      </a>
      {{/has_pending}}
      <button class="umat-btn umat-btn-outline" onclick="window.print()">
        <span class="material-symbols-outlined">download</span>
        Export Report
      </button>
    </div>
  </div>

  <!-- ================================================================ -->
  <!-- KPI Cards                                                         -->
  <!-- ================================================================ -->
  <div class="umat-kpi-grid">

    <div class="umat-kpi-card">
      <div class="umat-kpi-head">
        <div class="umat-kpi-icon kpi-icon-green">
          <span class="material-symbols-outlined">group</span>
        </div>
        <span class="umat-pill pill-ok">{{active_pct}}% active</span>
      </div>
      <div class="umat-kpi-label">Active Students</div>
      <div class="umat-kpi-val">{{active_students}}</div>
      <div style="font-size:12px;color:var(--ol);">of {{enrolled_students}} enrolled</div>
    </div>

    <div class="umat-kpi-card">
      <div class="umat-kpi-head">
        <div class="umat-kpi-icon kpi-icon-sec">
          <span class="material-symbols-outlined">forum</span>
        </div>
        <span class="umat-pill pill-info">30 days</span>
      </div>
      <div class="umat-kpi-label">AI Interactions</div>
      <div class="umat-kpi-val">{{total_interactions}}</div>
      <div style="font-size:12px;color:var(--ol);">avg {{avg_qps}} Q per session</div>
    </div>

    <div class="umat-kpi-card">
      <div class="umat-kpi-head">
        <div class="umat-kpi-icon kpi-icon-err">
          <span class="material-symbols-outlined">psychology_alt</span>
        </div>
        {{#struggle_count}}<span class="umat-pill pill-warn">{{struggle_count}} Q</span>{{/struggle_count}}
        {{^struggle_count}}<span class="umat-pill pill-ok">No data</span>{{/struggle_count}}
      </div>
      <div class="umat-kpi-label">Struggle Index</div>
      <div class="umat-kpi-val" style="font-size:22px;">{{struggle_index}}</div>
      <div style="font-size:12px;color:var(--ol);">Most-questioned material</div>
    </div>

    <div class="umat-kpi-card">
      <div class="umat-kpi-head">
        <div class="umat-kpi-icon kpi-icon-warn">
          <span class="material-symbols-outlined">pending_actions</span>
        </div>
        {{#has_pending}}<span class="umat-pill pill-warn">Needs review</span>{{/has_pending}}
        {{^has_pending}}<span class="umat-pill pill-ok">All clear</span>{{/has_pending}}
      </div>
      <div class="umat-kpi-label">Pending Approvals</div>
      <div class="umat-kpi-val">{{pending_approvals}}</div>
      <div style="font-size:12px;color:var(--ol);">AI outputs to review</div>
    </div>

  </div><!-- /kpi-grid -->

  <!-- ================================================================ -->
  <!-- Main 2-col section                                                -->
  <!-- ================================================================ -->
  <div class="umat-dash-main">

    <!-- ---- Left: engagement chart + performance breakdown ---- -->
    <div style="display:flex;flex-direction:column;gap:20px;">

      <!-- Engagement Trend Chart (14-day bar chart) -->
      <div class="umat-card">
        <div class="umat-card-header">
          <h3 class="umat-card-title">
            <span class="material-symbols-outlined">bar_chart</span>
            Student Engagement Trends
          </h3>
          <span class="umat-pill pill-info">14 days</span>
        </div>
        <div class="umat-card-body">
          <div class="umat-chart" id="umat-engagement-chart">
            {{#daily_counts}}
            <div class="umat-bar-wrap">
              <div
                class="umat-bar"
                style="height:{{count}}px;"
                data-count="{{count}}"
                title="{{label}}: {{count}} interactions"
              ></div>
              <div class="umat-bar-label">{{label}}</div>
            </div>
            {{/daily_counts}}
          </div>
          <div style="display:flex;gap:16px;margin-top:12px;">
            <span style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--ol);">
              <span style="width:12px;height:12px;border-radius:3px;background:var(--p);display:inline-block;"></span>
              AI Interactions
            </span>
          </div>
        </div>
      </div>

      <!-- Student Performance Breakdown -->
      <div class="umat-card">
        <div class="umat-card-header">
          <h3 class="umat-card-title">
            <span class="material-symbols-outlined">stacked_bar_chart</span>
            Student Performance Breakdown
          </h3>
          <span class="umat-pill pill-blue">Engagement-based estimate</span>
        </div>
        <div class="umat-card-body">
          <div class="umat-perf-item">
            <div class="umat-perf-row">
              <span class="umat-perf-label">🟢 High Engagement</span>
              <span class="umat-perf-num">{{high_performers}} students</span>
            </div>
            <div class="umat-perf-bar">
              <div class="umat-perf-bar-fill fill-high" style="width:{{#math}}{{high_performers}}/{{enrolled_students}}*100{{/math}}%;{{! inline calc not supported; JS handles this}}"></div>
            </div>
          </div>
          <div class="umat-perf-item">
            <div class="umat-perf-row">
              <span class="umat-perf-label">🔵 On Track</span>
              <span class="umat-perf-num">{{on_track}} students</span>
            </div>
            <div class="umat-perf-bar">
              <div class="umat-perf-bar-fill fill-track" id="dash-on-track-bar"></div>
            </div>
          </div>
          <div class="umat-perf-item">
            <div class="umat-perf-row">
              <span class="umat-perf-label">🔴 At Risk (inactive)</span>
              <span class="umat-perf-num">{{at_risk}} students</span>
            </div>
            <div class="umat-perf-bar">
              <div class="umat-perf-bar-fill fill-risk" id="dash-at-risk-bar"></div>
            </div>
          </div>
          <p style="font-size:11px;color:var(--ol);margin:10px 0 0;font-style:italic;">
            Breakdown estimated from AI interaction frequency. At-risk = enrolled but no AI interactions in 30 days.
          </p>
        </div>
      </div>

    </div><!-- /left col -->

    <!-- ---- Right: AI insights + heatmap ---- -->
    <div style="display:flex;flex-direction:column;gap:20px;">

      <!-- AI Learning Insight Bubble -->
      <div class="umat-card">
        <div class="umat-card-header">
          <h3 class="umat-card-title">
            <span class="material-symbols-outlined">auto_awesome</span>
            AI Insights
          </h3>
        </div>
        <div class="umat-card-body" style="display:flex;flex-direction:column;gap:12px;">

          {{#struggle_count}}
          <div class="umat-insight-big warn">
            <h4>
              <span class="material-symbols-outlined" style="color:var(--ter);">warning</span>
              Learning Gap: {{struggle_index}}
            </h4>
            <p>{{struggle_count}} student questions referenced this material — the most in the period. Consider scheduling a targeted review or adding supplementary content for it.</p>
            <div class="umat-insight-actions">
              <a href="{{approve_url}}" class="umat-insight-chip-btn">
                <span class="material-symbols-outlined">edit_note</span>Update Material
              </a>
            </div>
          </div>
          {{/struggle_count}}

          {{#at_risk}}
          <div class="umat-insight-big alert">
            <h4>
              <span class="material-symbols-outlined" style="color:#f59e0b;">notifications_active</span>
              Participation Alert
            </h4>
            <p>{{at_risk}} enrolled student(s) have not interacted with the AI assistant in the last 30 days. These students may need outreach.</p>
            <div class="umat-insight-actions">
              <span class="umat-insight-chip-btn" title="Use Moodle messaging to notify students">
                <span class="material-symbols-outlined">send</span>Notify Students
              </span>
            </div>
          </div>
          {{/at_risk}}

          <div class="umat-insight-big info">
            <h4>
              <span class="material-symbols-outlined" style="color:var(--p);">lightbulb</span>
              Strategic Recommendation
            </h4>
            <p>Based on AI interaction data, the highest engagement occurs mid-week. Consider scheduling live review sessions on Tuesday–Wednesday for maximum attendance.</p>
            <div class="umat-insight-actions">
              <span class="umat-insight-chip-btn">
                <span class="material-symbols-outlined">event</span>Schedule Review
              </span>
            </div>
          </div>

        </div>
      </div>

      <!-- Lecture Rewatch Heatmap (illustrative 7-week grid) -->
      <div class="umat-card">
        <div class="umat-card-header">
          <h3 class="umat-card-title">
            <span class="material-symbols-outlined">grid_view</span>
            AI Activity Heatmap
          </h3>
          <span class="umat-pill pill-info">7-day grid</span>
        </div>
        <div class="umat-card-body">
          <div class="umat-heatmap" id="umat-heatmap">
            <!-- Populated by JS from daily_counts -->
          </div>
          <div style="display:flex;align-items:center;gap:6px;margin-top:12px;font-size:11px;color:var(--ol);">
            <span>Less</span>
            <span style="width:12px;height:12px;border-radius:2px;background:var(--sfl);"></span>
            <span style="width:12px;height:12px;border-radius:2px;background:rgba(0,107,47,.3);"></span>
            <span style="width:12px;height:12px;border-radius:2px;background:rgba(0,107,47,.6);"></span>
            <span style="width:12px;height:12px;border-radius:2px;background:var(--p);"></span>
            <span>More</span>
          </div>
        </div>
      </div>

    </div><!-- /right col -->

  </div><!-- /dash-main -->

  <!-- ================================================================ -->
  <!-- Common Student Questions                                          -->
  <!-- ================================================================ -->
  <div class="umat-card" style="margin-bottom:24px;">
    <div class="umat-card-header">
      <h3 class="umat-card-title">
        <span class="material-symbols-outlined">help</span>
        Common AI-Logged Student Questions
      </h3>
      <span class="umat-pill pill-info">Top {{#top_questions}}1{{/top_questions}}0</span>
    </div>
    <div class="umat-card-body" style="padding:0;">
      {{#has_questions}}
      <table class="umat-q-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Question</th>
            <th>Count</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#top_questions}}
          <tr>
            <td style="color:var(--ol);font-weight:600;">{{@index}}</td>
            <td>{{text}}</td>
            <td><span class="q-count-chip">{{ask_count}}</span></td>
            <td style="white-space:nowrap;">
              <a href="{{approve_url}}" class="umat-insight-chip-btn" style="font-size:11px;padding:3px 9px;">
                Prepare Response
              </a>
            </td>
          </tr>
          {{/top_questions}}
        </tbody>
      </table>
      {{/has_questions}}
      {{^has_questions}}
      <div class="umat-empty">
        <span class="material-symbols-outlined">chat_bubble_outline</span>
        <p>No student questions logged yet for this course. Questions will appear here once students start using the AI assistant.</p>
      </div>
      {{/has_questions}}
    </div>
  </div>

  <!-- ================================================================ -->
  <!-- Struggle Insights Section (5-Zone Actionable Layout)               -->
  <!-- ================================================================ -->
  <div class="umat-section-divider"></div>

  {{> local_umat_ai/analytics_dashboard }}

</div><!-- /umat-dash-wrap -->

<script>
(function() {
  'use strict';

  var enrolled    = {{enrolled_students}};
  var high        = {{high_performers}};
  var onTrack     = {{on_track}};
  var atRisk      = {{at_risk}};
  var maxCount    = {{max_count}} || 1;
  var dailyCounts = {{{daily_counts_json}}};

  /* ---- Scale chart bars proportionally ---- */
  var CHART_HEIGHT = 180;
  document.querySelectorAll('#umat-engagement-chart .umat-bar').forEach(function(bar) {
    var cnt     = parseInt(bar.getAttribute('data-count')) || 0;
    var height  = Math.max(2, Math.round((cnt / maxCount) * CHART_HEIGHT));
    bar.style.height = height + 'px';
  });

  /* ---- Performance bars ---- */
  function setPct(el, n, total) {
    if (!el) return;
    el.style.width = (total > 0 ? Math.round(n / total * 100) : 0) + '%';
  }
  setPct(document.getElementById('dash-on-track-bar'), onTrack, enrolled);
  setPct(document.getElementById('dash-at-risk-bar'),  atRisk,  enrolled);
  /* high-engagement bar is set inline via mustache (width needs JS since mustache can't divide) */
  var highBar = document.querySelector('.fill-high');
  if (highBar) setPct(highBar, high, enrolled);

  /* ---- Heatmap (last 7 entries from dailyCounts) ---- */
  var heatmap = document.getElementById('umat-heatmap');
  if (heatmap && dailyCounts && dailyCounts.length > 0) {
    var last7   = dailyCounts.slice(-7);
    var maxHeat = Math.max.apply(null, last7.map(function(d) { return d.count; })) || 1;
    heatmap.innerHTML = last7.map(function(d) {
      var pct     = d.count / maxHeat;
      var opacity = Math.max(0.08, pct);
      var bg      = pct === 0
        ? 'background:var(--sfl)'
        : 'background:rgba(0,107,47,' + opacity.toFixed(2) + ')';
      return '<div class="umat-heat-cell" style="' + bg + '" title="' + d.label + ': ' + d.count + '">' +
               '<span style="font-size:9px;color:rgba(0,107,47,0.8);">' + d.count + '</span>' +
             '</div>';
    }).join('') +
    last7.map(function(d) {
      return '<div class="umat-heat-label">' + d.label.substring(0, 3) + '</div>';
    }).join('');
  }

  /* ---- Struggle Insights: delegated to local_umat_ai/analytics_dashboard AMD module ---- */
  var courseId = {{courseid}};
  if (courseId) {
    require(['local_umat_ai/analytics_dashboard'], function(AD) {
      AD.init(courseId);
      window.analyticsDashboard = AD;
    });
  }

  function escapeHtml(s) {
    if (!s) return '';
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

})();
</script>
