{{!
    Template: local/umat_ai/templates/analytics_dashboard.mustache
    Lecturer Insights Dashboard — 5-zone actionable insights layout.

    AI-powered insights across all zones.

    Context (provided by JS):
      courseid, coursefullname
    New API fields:
      executive_summary, health_grade, health_label, going_well,
      needs_attention, top_recommendation, metric_explanations
}}
<div class="umat-insights-pane" data-courseid="{{{courseid}}}">

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 0: Executive Summary Briefing                                 -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone ins-exec-summary-zone" id="ins-exec-summary-zone">
    <!-- Health grade badge (left) + 2-3 sentence briefing (right) -->
    <div class="ins-exs-row">
      <div class="ins-exs-grade" id="ins-exs-grade">
        <span class="ins-exs-grade-letter" id="ins-exs-grade-letter">—</span>
        <span class="ins-exs-grade-label" id="ins-exs-grade-label">Course Health</span>
      </div>
      <div class="ins-exs-briefing" id="ins-exs-briefing">
        <div class="ins-exs-summary" id="ins-exs-summary">Loading executive summary…</div>
        <div class="ins-exs-top-rec" id="ins-exs-top-rec"></div>
      </div>
    </div>
    <!-- Going Well / Needs Attention (side-by-side chips) -->
    <div class="ins-exs-lists">
      <div class="ins-exs-list ins-exs-going-well" id="ins-exs-going-well">
        <span class="ins-exs-list-icon"><span class="material-symbols-outlined">check_circle</span></span>
        <div class="ins-exs-list-items" id="ins-exs-going-well-items"></div>
      </div>
      <div class="ins-exs-list ins-exs-needs-attention" id="ins-exs-needs-attention">
        <span class="ins-exs-list-icon"><span class="material-symbols-outlined">warning</span></span>
        <div class="ins-exs-list-items" id="ins-exs-needs-attention-items"></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 5 (now first): Course Pulse — How your course is performing     -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-vitals-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">monitor_heart</span>
      Course Pulse
    </h3>
    <div id="ins-course-pulse" class="ins-pulse-grid"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 1: Priority Briefing — What needs your attention right now     -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-priority-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">notification_important</span>
      What Needs Your Attention
    </h3>
    <div id="ins-priority-actions" class="ins-priority-list"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 2: Struggle Map — Where students are confused                  -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-struggle-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">map</span>
      Where Students Are Struggling
    </h3>

    <!-- Topic Struggle Cards (narrative cards) -->
    <div id="ins-struggle-areas" class="ins-struggle-list"></div>

    <!-- Section Struggle Bars -->
    <div id="ins-section-breakdown" class="ins-section-bars"></div>

    <!-- Material Struggle List -->
    <div id="ins-material-struggle" class="ins-material-list"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 3: Student Dossiers — Who needs help and why                   -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-students-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">groups</span>
      Your Students
    </h3>

    <!-- Smart Filters -->
    <div class="ins-filter-row" id="ins-filters">
      <button class="ins-chip ins-chip-active" data-filter="all" onclick="window.analyticsDashboard.setFilter('all', this)">All</button>
      <button class="ins-chip" data-filter="disengaged" onclick="window.analyticsDashboard.setFilter('disengaged', this)">
        <span class="material-symbols-outlined">person_off</span> Disengaged
      </button>
      <button class="ins-chip" data-filter="struggling" onclick="window.analyticsDashboard.setFilter('struggling', this)">
        <span class="material-symbols-outlined">psychology</span> Struggling
      </button>
      <button class="ins-chip" data-filter="failing" onclick="window.analyticsDashboard.setFilter('failing', this)">
        <span class="material-symbols-outlined">trending_down</span> Failing
      </button>
      <button class="ins-chip" data-filter="issues" onclick="window.analyticsDashboard.setFilter('issues', this)">
        <span class="material-symbols-outlined">report</span> Issues
      </button>
    </div>

    <!-- Student Narrative Cards -->
    <div id="ins-student-list" class="ins-student-cards">
      <div class="ins-empty">No student data loaded yet.</div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 4: Question Radar — What students are asking                   -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-questions-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">question_answer</span>
      What Students Are Asking
    </h3>
    <div id="ins-common-questions" class="ins-question-list"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- Student Detail Panel (slide-in overlay)                             -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div class="ins-detail-panel" id="ins-detail-panel" style="display:none;">
    <div class="ins-detail-header">
      <div>
        <strong id="ins-detail-name">—</strong>
        <span class="ins-pill" id="ins-detail-risk-badge">—</span>
      </div>
      <button class="ins-chip-sm" onclick="window.analyticsDashboard.closeDetail()">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <div class="ins-detail-body" id="ins-detail-body">
      <div class="ins-empty">Loading profile…</div>
    </div>
    <div class="ins-detail-actions">
      <button class="ins-action-btn" onclick="window.analyticsDashboard.openActionDrawer('encouragement')">
        <span class="material-symbols-outlined">favorite</span> Encourage
      </button>
      <button class="ins-action-btn" onclick="window.analyticsDashboard.openActionDrawer('meeting')">
        <span class="material-symbols-outlined">event</span> 1:1
      </button>
      <button class="ins-action-btn" onclick="window.analyticsDashboard.openActionDrawer('remedial_quiz')">
        <span class="material-symbols-outlined">quiz</span> Quiz
      </button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- Action Drawer (slide-up for interventions)                          -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div class="ins-action-drawer" id="ins-action-drawer" style="display:none;">
    <div class="ins-drawer-backdrop" onclick="window.analyticsDashboard.closeActionDrawer()"></div>
    <div class="ins-drawer-content">
      <div class="ins-drawer-header">
        <h3 id="ins-drawer-title">Send Intervention</h3>
        <button class="ins-chip-sm" onclick="window.analyticsDashboard.closeActionDrawer()">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="ins-drawer-body">
        <p id="ins-drawer-recipient" style="font-size:13px;color:var(--u-ol);margin:0 0 12px;"></p>
        <textarea id="ins-drawer-message" class="ins-drawer-textarea"
          placeholder="Draft your message…" rows="4"></textarea>
        <div id="ins-drawer-status" style="font-size:12px;margin-top:8px;display:none;"></div>
      </div>
      <div class="ins-drawer-footer">
        <button class="ins-btn ins-btn-secondary" onclick="window.analyticsDashboard.closeActionDrawer()">Cancel</button>
        <button class="ins-btn ins-btn-primary" id="ins-drawer-send-btn" onclick="window.analyticsDashboard.sendIntervention()">
          <span class="material-symbols-outlined">send</span> Send
        </button>
      </div>
    </div>
  </div>

  <!-- Shimmer skeleton placeholder for initial load -->
  <div class="ins-skeleton" id="ins-skeleton" style="display:none;">
    <div class="ins-shimmer-block" style="width:100%;height:80px;"></div>
    <div class="ins-shimmer-block" style="width:100%;height:120px;"></div>
    <div class="ins-shimmer-block" style="width:100%;height:200px;"></div>
    <div class="ins-shimmer-block" style="width:100%;height:150px;"></div>
  </div>
</div>
