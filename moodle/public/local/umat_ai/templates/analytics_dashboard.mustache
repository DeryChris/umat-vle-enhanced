{{!
    Template: local/umat_ai/templates/analytics_dashboard.mustache
    Lecturer Insights Dashboard — 5-zone actionable insights layout.

    Context (provided by JS):
      courseid, coursefullname
}}
<div class="umat-insights-pane">

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- AI TEACHING RECOMMENDATIONS — Top priority actions for the lecturer  -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-recommendations-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">auto_awesome</span>
      AI Teaching Recommendations
    </h3>
    <div id="ins-priority-recommendations" class="ins-priority-list"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 1: Students At Risk — with drill-down evidence and actions      -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-students-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">groups</span>
      Students At Risk
      <span class="ins-badge" id="ins-at-risk-count">0</span>
      <span class="ins-expand-all" onclick="window.analyticsDashboard.expandAllCards()">Expand All</span>
    </h3>
    <div id="ins-students-at-risk" class="ins-student-cards"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 2: Topic Struggle — with student lists, quiz questions, AI Qs   -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-struggle-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">map</span>
      Topic Struggle Analysis
    </h3>
    <div id="ins-topic-struggles" class="ins-struggle-list"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 3: Quiz Analytics — with question-level detail                  -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-quiz-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">quiz</span>
      Quiz Analytics
    </h3>
    <div id="ins-quiz-analytics" class="ins-quiz-analytics"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 4: Lecture Recording Analytics                                  -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-recording-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">play_circle</span>
      Lecture Recording Analytics
    </h3>
    <div id="ins-recording-analytics" class="ins-recording-list"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 5: Resource Analytics                                           -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-resource-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">school</span>
      Resource Analytics
    </h3>
    <div id="ins-resource-analytics" class="ins-resource-list"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 6: AI Learning Analytics                                        -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-ai-analytics-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">psychology</span>
      AI Learning Analytics
    </h3>
    <div id="ins-ai-learning-analytics" class="ins-ai-analytics"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 7: Common Questions (existing)                                   -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-questions-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">question_answer</span>
      What Students Are Asking
    </h3>
    <div id="ins-common-questions" class="ins-question-list"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ZONE 8: NLQ Search                                                    -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <section class="ins-zone" id="ins-nlq-zone">
    <h3 class="ins-zone-title">
      <span class="material-symbols-outlined">smart_toy</span>
      Ask About Your Students
    </h3>
    <div class="ins-nlq-bar">
      <input type="text" id="ins-nlq-input" class="ins-nlq-input"
        placeholder="Ask about student performance…" />
      <button class="ins-nlq-btn" onclick="window.analyticsDashboard.submitNLQ()">
        <span class="material-symbols-outlined">search</span>
      </button>
      <div class="ins-nlq-spinner" id="ins-nlq-spinner" style="display:none;"></div>
    </div>
    <div id="ins-nlq-response" class="ins-nlq-response umat-ai-stream-panel" style="display:none;"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- Student Timeline Panel                                                -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div class="ins-detail-panel ins-timeline-panel" id="ins-detail-panel" style="display:none;">
    <div class="ins-detail-header">
      <div>
        <strong id="ins-detail-name">—</strong>
        <span class="ins-pill" id="ins-detail-risk-badge">—</span>
      </div>
      <button class="ins-chip-sm" onclick="window.analyticsDashboard.closeDetail()">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <div class="ins-detail-body" id="ins-detail-body">
      <div class="ins-empty">Loading profile…</div>
    </div>
    <div class="ins-detail-actions">
      <button class="ins-action-btn" onclick="window.analyticsDashboard.handleStudentAction('send_message', window.analyticsDashboard.currentDetailUid || 0)">
        <span class="material-symbols-outlined">mail</span> Message
      </button>
      <button class="ins-action-btn" onclick="window.analyticsDashboard.handleStudentAction('recommend_resource', window.analyticsDashboard.currentDetailUid || 0)">
        <span class="material-symbols-outlined">school</span> Recommend
      </button>
      <button class="ins-action-btn" onclick="window.analyticsDashboard.handleStudentAction('view_activity', window.analyticsDashboard.currentDetailUid || 0)">
        <span class="material-symbols-outlined">timeline</span> Activity
      </button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- Action Drawer                                                         -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div class="ins-action-drawer" id="ins-action-drawer" style="display:none;">
    <div class="ins-drawer-backdrop" onclick="window.analyticsDashboard.closeActionDrawer()"></div>
    <div class="ins-drawer-content">
      <div class="ins-drawer-header">
        <h3 id="ins-drawer-title">Send Intervention</h3>
        <button class="ins-chip-sm" onclick="window.analyticsDashboard.closeActionDrawer()">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="ins-drawer-body">
        <p id="ins-drawer-recipient" style="font-size:13px;color:var(--u-ol);margin:0 0 12px;"></p>
        <textarea id="ins-drawer-message" class="ins-drawer-textarea"
          placeholder="Draft your message…" rows="4"></textarea>
        <div id="ins-drawer-status" style="font-size:12px;margin-top:8px;display:none;"></div>
      </div>
      <div class="ins-drawer-footer">
        <button class="ins-btn ins-btn-secondary" onclick="window.analyticsDashboard.closeActionDrawer()">Cancel</button>
        <button class="ins-btn ins-btn-primary" id="ins-drawer-send-btn" onclick="window.analyticsDashboard.sendIntervention()">
          <span class="material-symbols-outlined">send</span> Send
        </button>
      </div>
    </div>
  </div>

  <!-- Shimmer skeleton placeholder for initial load -->
  <div class="ins-skeleton" id="ins-skeleton" style="display:none;">
    <div class="ins-shimmer-block" style="width:100%;height:80px;"></div>
    <div class="ins-shimmer-block" style="width:100%;height:120px;"></div>
    <div class="ins-shimmer-block" style="width:100%;height:200px;"></div>
    <div class="ins-shimmer-block" style="width:100%;height:150px;"></div>
  </div>
</div>
