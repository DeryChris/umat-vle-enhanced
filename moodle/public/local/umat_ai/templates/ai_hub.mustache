{{!
    Template: local/umat_ai/templates/ai_hub.mustache
    General AI Hub - cross-course AI conversations and session logs.

    Uses CSS variables that inherit from theme or fall back to defaults.
    Works standalone or with any Moodle theme.
}}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<style>
:root {
    --ai-primary: #006b2f;
    --ai-primary-dark: #005523;
    --ai-primary-light: #00873d;
    --ai-primary-bg: #dcfce7;
    --ai-surface: white;
    --ai-surface-alt: #f8f9fb;
    --ai-text: #1a1c19;
    --ai-text-muted: #6e7a6d;
    --ai-border: #dee5da;
    --ai-success: #4ade80;
    --ai-user-bubble: #dcfce7;
    --ai-user-text: #00210a;
    --ai-shadow: rgba(0,0,0,0.08);
    --ai-radius: 16px;
}
.ai-hub-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Inter', sans-serif;
}
.ai-hub-header { margin-bottom: 32px; }
.ai-hub-title {
    font-size: 28px;
    font-weight: 700;
    color: var(--ai-primary);
    margin-bottom: 8px;
}
.ai-hub-subtitle {
    color: var(--ai-text-muted);
    font-size: 14px;
}
.ai-bento-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 24px;
}
@media (max-width: 768px) {
    .ai-bento-grid { grid-template-columns: 1fr; }
}
.ai-learning-pulse,
.ai-chat-section,
.ai-session-card {
    background: var(--ai-surface);
    border-radius: var(--ai-radius);
    padding: 24px;
    box-shadow: 0 4px 12px var(--ai-shadow);
    border: 1px solid var(--ai-border);
}
.ai-pulse-header,
.ai-sessions-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}
.ai-pulse-title,
.ai-sessions-title,
.ai-chat-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--ai-text);
}
.ai-pulse-icon {
    color: var(--ai-primary);
    font-size: 24px;
}
.ai-pulse-desc {
    font-size: 14px;
    color: var(--ai-text-muted);
    margin-bottom: 20px;
}
.ai-topic-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
}
.ai-topic-tag {
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    background: var(--ai-primary-bg);
    color: var(--ai-primary);
}
.ai-goal-section {
    padding-top: 16px;
    border-top: 1px solid var(--ai-border);
}
.ai-goal-label {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    margin-bottom: 8px;
    color: var(--ai-text-muted);
}
.ai-goal-label span:last-child {
    font-weight: 600;
    color: var(--ai-primary);
}
.ai-goal-bar {
    height: 8px;
    background: var(--ai-surface-alt);
    border-radius: 4px;
    overflow: hidden;
}
.ai-goal-progress {
    height: 100%;
    background: linear-gradient(90deg, var(--ai-primary), var(--ai-primary-light));
    border-radius: 4px;
    transition: width 0.5s ease;
}
.ai-chat-section {
    display: flex;
    flex-direction: column;
    min-height: 400px;
}
.ai-chat-header {
    padding: 16px 24px;
    border-bottom: 1px solid var(--ai-border);
    display: flex;
    align-items: center;
    gap: 12px;
}
.ai-chat-icon {
    width: 40px;
    height: 40px;
    background: var(--ai-primary-bg);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ai-primary);
}
.ai-course-selector {
    margin-left: auto;
    padding: 8px 12px;
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    font-size: 13px;
    color: var(--ai-text);
    background: var(--ai-surface);
    cursor: pointer;
}
.ai-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
    background: var(--ai-surface-alt);
    display: flex;
    flex-direction: column;
    gap: 16px;
}
.ai-chat-msg {
    display: flex;
    max-width: 80%;
}
.ai-chat-msg.user { align-self: flex-end; }
.ai-chat-msg.ai { align-self: flex-start; }
.ai-msg-bubble {
    padding: 14px 18px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.5;
}
.ai-chat-msg.user .ai-msg-bubble {
    background: var(--ai-user-bubble);
    color: var(--ai-user-text);
    border-bottom-right-radius: 4px;
}
.ai-chat-msg.ai .ai-msg-bubble {
    background: var(--ai-surface);
    border-left: 4px solid var(--ai-primary);
    border-bottom-left-radius: 4px;
}
.ai-chat-input {
    padding: 16px 24px;
    border-top: 1px solid var(--ai-border);
    background: var(--ai-surface);
}
.ai-input-row {
    display: flex;
    gap: 12px;
}
.ai-input-row input {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
}
.ai-input-row input:focus {
    outline: none;
    border-color: var(--ai-primary);
}
.ai-send-btn {
    padding: 12px 24px;
    background: var(--ai-primary);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
}
.ai-send-btn:hover { background: var(--ai-primary-light); }
.ai-sessions-section { margin-top: 32px; }
.ai-session-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
}
.ai-session-card {
    padding: 20px;
    cursor: pointer;
    transition: all 0.2s ease;
}
.ai-session-card:hover {
    border-color: var(--ai-primary);
    box-shadow: 0 4px 12px rgba(0,107,47,0.15);
    transform: translateY(-2px);
}
.ai-session-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}
.ai-course-badge {
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    background: var(--ai-primary-bg);
    color: var(--ai-primary);
}
.ai-session-time {
    font-size: 12px;
    color: var(--ai-text-muted);
}
.ai-session-preview {
    font-size: 14px;
    color: var(--ai-text-muted);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>

<div class="ai-hub-container">
    <div class="ai-hub-header">
        <h1 class="ai-hub-title">{{#str}}ai_hub_title, local_umat_ai{{/str}}</h1>
        <p class="ai-hub-subtitle">{{#str}}ai_hub_subtitle, local_umat_ai{{/str}}</p>
    </div>

    <div class="ai-bento-grid">
        <div class="ai-learning-pulse">
            <div class="ai-pulse-header">
                <h2 class="ai-pulse-title">{{#str}}learning_pulse, local_umat_ai{{/str}}</h2>
                <span class="material-symbols-outlined ai-pulse-icon">bolt</span>
            </div>
            <p class="ai-pulse-desc">{{#str}}pulse_description, local_umat_ai{{/str}}</p>

            <div class="ai-topic-tags" id="topic-tags">
                <span class="ai-topic-tag">Mine Surveying</span>
                <span class="ai-topic-tag">Calculus III</span>
                <span class="ai-topic-tag">Mineral Proc.</span>
                <span class="ai-topic-tag">Geology</span>
            </div>

            <div class="ai-goal-section">
                <div class="ai-goal-label">
                    <span>{{#str}}study_goal, local_umat_ai{{/str}}</span>
                    <span>{{goalprogress}}%</span>
                </div>
                <div class="ai-goal-bar">
                    <div class="ai-goal-progress" style="width: {{goalprogress}}%"></div>
                </div>
            </div>
        </div>

        <div class="ai-chat-section">
            <div class="ai-chat-header">
                <div class="ai-chat-icon">
                    <span class="material-symbols-outlined">forum</span>
                </div>
                <h3 class="ai-chat-title">{{#str}}general_chat, local_umat_ai{{/str}}</h3>
                <select class="ai-course-selector" id="course-selector">
                    <option value="0">{{#str}}all_courses, local_umat_ai{{/str}}</option>
                    <option value="2">EL 452 - Renewable Energy</option>
                    <option value="3">CS 301 - Data Structures</option>
                </select>
            </div>

            <div class="ai-chat-messages" id="hub-chat-messages">
                <div class="ai-chat-msg ai">
                    <div class="ai-msg-bubble">
                        <p>{{#str}}hub_greeting, local_umat_ai{{/str}}</p>
                    </div>
                </div>
            </div>

            <div class="ai-chat-input">
                <div class="ai-input-row">
                    <input type="text" id="hub-question-input" placeholder="{{#str}}ask_placeholder, local_umat_ai{{/str}}" maxlength="500" />
                    <button class="ai-send-btn" id="hub-send-btn">
                        <span class="material-symbols-outlined">send</span>
                        {{#str}}send, local_umat_ai{{/str}}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="ai-sessions-section">
        <div class="ai-sessions-header">
            <h2 class="ai-sessions-title">{{#str}}recent_sessions, local_umat_ai{{/str}}</h2>
            <button class="ai-send-btn" style="padding: 8px 16px;">
                <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
                {{#str}}new_session, local_umat_ai{{/str}}
            </button>
        </div>

        <div class="ai-session-cards" id="session-cards">
            <div class="ai-session-card" data-session-id="1">
                <div class="ai-session-header">
                    <span class="ai-course-badge">EL 452</span>
                    <span class="ai-session-time">2 hours ago</span>
                </div>
                <p class="ai-session-preview">Discussed solar panel efficiency calculations and grid synchronization requirements...</p>
            </div>
            <div class="ai-session-card" data-session-id="2">
                <div class="ai-session-header">
                    <span class="ai-course-badge">CS 301</span>
                    <span class="ai-session-time">Yesterday</span>
                </div>
                <p class="ai-session-preview">Reviewed binary tree traversal algorithms and their time complexity analysis...</p>
            </div>
            <div class="ai-session-card" data-session-id="3">
                <div class="ai-session-header">
                    <span class="ai-course-badge">GE 201</span>
                    <span class="ai-session-time">3 days ago</span>
                </div>
                <p class="ai-session-preview">Explained igneous rock formation processes and mineral crystallization sequences...</p>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var sendBtn = document.getElementById('hub-send-btn');
    var input = document.getElementById('hub-question-input');
    var messagesContainer = document.getElementById('hub-chat-messages');
    var courseSelector = document.getElementById('course-selector');

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(text));
        return div.innerHTML;
    }

    function addMessage(text, isUser) {
        var msgDiv = document.createElement('div');
        msgDiv.className = 'ai-chat-msg ' + (isUser ? 'user' : 'ai');
        msgDiv.innerHTML = '<div class="ai-msg-bubble"><p>' + escapeHtml(text) + '</p></div>';
        messagesContainer.appendChild(msgDiv);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function sendQuestion(question) {
        if (!question.trim()) return;

        addMessage(question, true);
        input.value = '';

        var typingDiv = document.createElement('div');
        typingDiv.className = 'ai-chat-msg ai';
        typingDiv.id = 'typing-indicator';
        typingDiv.innerHTML = '<div class="ai-msg-bubble"><p><em>{{#str}}ai_thinking, local_umat_ai{{/str}}</em></p></div>';
        messagesContainer.appendChild(typingDiv);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        var selectedCourse = courseSelector.value;

        require(['core/ajax'], function(Ajax) {
            Ajax.call([{
                methodname: 'local_umat_ai_ask_question',
                args: {
                    courseid: selectedCourse == '0' ? 1 : parseInt(selectedCourse),
                    question: question
                }
            }])[0].done(function(response) {
                var indicator = document.getElementById('typing-indicator');
                if (indicator) indicator.remove();

                if (response.success) {
                    addMessage(response.answer, false);
                } else {
                    addMessage('{{#str}}error_message, local_umat_ai{{/str}}', false);
                }
            }).fail(function() {
                var indicator = document.getElementById('typing-indicator');
                if (indicator) indicator.remove();
                addMessage('{{#str}}connection_error, local_umat_ai{{/str}}', false);
            });
        });
    }

    if (sendBtn) {
        sendBtn.addEventListener('click', function() {
            sendQuestion(input.value);
        });
    }

    if (input) {
        input.addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendQuestion(input.value);
            }
        });
    }

    document.querySelectorAll('.ai-session-card').forEach(function(card) {
        card.addEventListener('click', function() {
            var sessionId = this.dataset.sessionId;
            window.location.href = '{{wwwroot}}/local/umat_ai/index.php?sessionid=' + sessionId;
        });
    });
});
</script>