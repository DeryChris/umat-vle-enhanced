{{! AI Learning Hub — matches general_hub.png design }}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200">

<style>
:root{--p:#006b2f;--pb:#00873d;--op:#fff;--sf:#f5fbf0;--sfl:#eff6eb;--sflo:#fff;--ons:#171d17;--onsv:#3e4a3e;--ol:#6e7a6d;--olv:#bdcaba;--sec:#3d6844;--secc:#beefc1;--ter:#a5304d;--r8:8px;--r12:12px;--r16:16px;--r20:20px;--rp:9999px;--sb-col:64px;--sb-exp:240px;--topnav:56px;}
*,*::before,*::after{box-sizing:border-box;}
html,body{margin:0;padding:0;height:100%;overflow:hidden;}
.hub-root{display:flex;flex-direction:column;height:100vh;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:var(--ons);background:var(--sf);}

/* Top nav */
.hub-topnav{height:var(--topnav);background:var(--sflo);border-bottom:1px solid var(--olv);display:flex;align-items:center;padding:0 20px;gap:18px;flex-shrink:0;}
.hub-brand{font-size:15px;font-weight:800;color:var(--p);display:flex;flex-direction:column;line-height:1.1;white-space:nowrap;}
.hub-brand span{font-size:11px;font-weight:500;color:var(--ol);}
.hub-nav-tabs{display:flex;gap:2px;flex:1;}
.hub-nav-tab{padding:6px 14px;border-radius:var(--rp);border:none;background:none;font-size:13px;font-weight:500;color:var(--ol);cursor:pointer;transition:all .2s;font-family:inherit;text-decoration:none;white-space:nowrap;}
.hub-nav-tab:hover{color:var(--ons);background:var(--sfl);}
.hub-nav-tab.active{color:var(--p);background:rgba(0,107,47,.08);font-weight:700;}
.hub-search{display:flex;align-items:center;gap:7px;padding:7px 13px;background:var(--sfl);border:1px solid var(--olv);border-radius:var(--rp);min-width:200px;}
.hub-search .material-symbols-outlined{font-size:16px;color:var(--ol);}
.hub-search input{border:none;background:none;outline:none;font-size:13px;color:var(--ons);font-family:inherit;width:140px;}
.hub-icon-btn{width:34px;height:34px;border-radius:50%;background:none;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--ol);transition:all .2s;}
.hub-icon-btn .material-symbols-outlined{font-size:20px;}
.hub-icon-btn:hover{background:var(--sfl);color:var(--ons);}
.hub-avatar-pill{width:32px;height:32px;border-radius:50%;background:var(--p);color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0;cursor:pointer;}

/* Body */
.hub-body{display:flex;flex:1;overflow:hidden;}

/* Sidebar (identical to overlay sidebar) */
.hub-sb{width:var(--sb-col);background:var(--sflo);border-right:1px solid var(--olv);display:flex;flex-direction:column;overflow:hidden;transition:width .32s cubic-bezier(.4,0,.2,1);flex-shrink:0;}
.hub-sb:hover{width:var(--sb-exp);}
.hub-sb-logo{display:flex;align-items:center;gap:12px;padding:16px;overflow:hidden;border-bottom:1px solid var(--olv);min-height:72px;flex-shrink:0;}
.hub-sb-logo-icon{width:32px;height:32px;border-radius:var(--r8);background:linear-gradient(135deg,var(--p),var(--pb));color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.hub-sb-logo-text{white-space:nowrap;overflow:hidden;opacity:0;transition:opacity .2s;}
.hub-sb:hover .hub-sb-logo-text{opacity:1;}
.hub-sb-logo-text strong{display:block;font-size:13px;font-weight:700;color:var(--p);}
.hub-sb-logo-text span{font-size:11px;color:var(--ol);}
.hub-sb-nav{flex:1;overflow-y:auto;overflow-x:hidden;padding:8px 0;display:flex;flex-direction:column;}
.hub-sb-item{display:flex;align-items:center;gap:14px;padding:11px 16px;cursor:pointer;transition:background .18s;white-space:nowrap;overflow:hidden;text-decoration:none;color:var(--onsv);border-left:3px solid transparent;}
.hub-sb-item:hover{background:var(--sfl);color:var(--ons);}
.hub-sb-item.active{background:rgba(0,107,47,.08);color:var(--p);border-left-color:var(--p);font-weight:600;}
.hub-sb-item .material-symbols-outlined{font-size:22px;flex-shrink:0;}
.hub-sb-item-lbl{font-size:13px;font-weight:500;opacity:0;transition:opacity .18s;overflow:hidden;}
.hub-sb:hover .hub-sb-item-lbl{opacity:1;}
.hub-sb-divider{height:1px;background:var(--olv);margin:6px 12px;}
.hub-sb-new{display:flex;align-items:center;gap:12px;margin:8px;padding:10px 12px;background:var(--p);color:#fff;border-radius:var(--r8);cursor:pointer;border:none;font-family:inherit;font-size:13px;font-weight:700;white-space:nowrap;overflow:hidden;transition:background .2s;flex-shrink:0;}
.hub-sb-new:hover{background:var(--pb);}
.hub-sb-new .material-symbols-outlined{font-size:18px;flex-shrink:0;}
.hub-sb-new-lbl{opacity:0;transition:opacity .18s;overflow:hidden;}
.hub-sb:hover .hub-sb-new-lbl{opacity:1;}
.hub-sb-footer{padding:8px 0 10px;border-top:1px solid var(--olv);flex-shrink:0;}

/* Main content */
.hub-main{flex:1;overflow-y:auto;padding:24px;background:var(--sf);}
.hub-main::-webkit-scrollbar{width:5px;}
.hub-main::-webkit-scrollbar-thumb{background:var(--olv);border-radius:3px;}

/* Week stats */
.hub-stats{display:flex;gap:12px;margin-bottom:22px;flex-wrap:wrap;}
.hub-stat-card{background:var(--sflo);border:1px solid var(--olv);border-radius:var(--r12);padding:14px 18px;display:flex;align-items:center;gap:12px;flex:1;min-width:160px;}
.hub-stat-icon{width:36px;height:36px;border-radius:var(--r8);display:flex;align-items:center;justify-content:center;}
.hub-stat-icon .material-symbols-outlined{font-size:20px;}
.hub-stat-val{font-size:22px;font-weight:800;color:var(--ons);line-height:1;}
.hub-stat-lbl{font-size:11px;color:var(--ol);margin-top:2px;}

/* Bento grid */
.hub-bento{display:grid;grid-template-columns:320px 1fr;gap:18px;margin-bottom:24px;}
@media(max-width:960px){.hub-bento{grid-template-columns:1fr;}}

/* Cards */
.hub-card{background:var(--sflo);border:1px solid var(--olv);border-radius:var(--r16);overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.04);}
.hub-card-hdr{padding:14px 18px;border-bottom:1px solid var(--olv);display:flex;align-items:center;justify-content:space-between;}
.hub-card-title{margin:0;font-size:15px;font-weight:700;color:var(--ons);display:flex;align-items:center;gap:8px;}
.hub-card-title .material-symbols-outlined{font-size:18px;color:var(--p);}
.hub-card-body{padding:18px;}

/* Topic tags */
.hub-topic-tags{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:16px;}
.hub-topic-tag{padding:5px 12px;border-radius:var(--rp);background:var(--secc);color:var(--sec);font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:4px;}
.hub-topic-tag .material-symbols-outlined{font-size:13px;}

/* Goal bar */
.hub-goal-section{border-top:1px solid var(--olv);padding-top:14px;}
.hub-goal-row{display:flex;justify-content:space-between;font-size:12px;color:var(--onsv);margin-bottom:6px;}
.hub-goal-row strong{color:var(--p);}
.hub-goal-bar{height:8px;background:var(--sfl);border-radius:4px;overflow:hidden;}
.hub-goal-fill{height:100%;background:linear-gradient(90deg,var(--p),var(--pb));border-radius:4px;transition:width .5s ease;}
.hub-goal-sub{font-size:11px;color:var(--ol);margin-top:6px;}

/* Chat area */
.hub-chat{display:flex;flex-direction:column;height:460px;position:relative;}
.hub-chat-hdr{padding:14px 18px;border-bottom:1px solid var(--olv);display:flex;align-items:center;gap:10px;background:var(--sflo);}
.hub-chat-icon{width:36px;height:36px;background:rgba(0,107,47,.1);border-radius:var(--r8);display:flex;align-items:center;justify-content:center;color:var(--p);}
.hub-chat-icon .material-symbols-outlined{font-size:20px;}
.hub-chat-title{font-size:14px;font-weight:700;flex:1;}
.hub-chat-sub{font-size:11px;color:var(--p);font-weight:600;display:flex;align-items:center;gap:4px;}
.hub-chat-expand{background:none;border:none;cursor:pointer;padding:4px;color:var(--ol);border-radius:var(--r8);transition:all .2s;}
.hub-chat-expand:hover{background:var(--sfl);color:var(--ons);}
.hub-chat-expand .material-symbols-outlined{font-size:18px;}
.hub-course-sel{margin-left:auto;padding:6px 10px;border:1px solid var(--olv);border-radius:var(--rp);font-size:12px;color:var(--ons);background:var(--sflo);cursor:pointer;font-family:inherit;max-width:160px;}
.hub-msgs{flex:1;overflow-y:auto;padding:16px 16px 72px;background:var(--sf);display:flex;flex-direction:column;gap:12px;}
.hub-msgs::-webkit-scrollbar{width:4px;}
.hub-msgs::-webkit-scrollbar-thumb{background:var(--olv);border-radius:2px;}
.hub-msg{display:flex;flex-direction:column;max-width:82%;}
.hub-msg.user{align-self:flex-end;}
.hub-msg.ai{align-self:flex-start;}
.hub-bubble{padding:12px 14px;border-radius:var(--r12);font-size:13px;line-height:1.55;}
.hub-msg.user .hub-bubble{background:linear-gradient(135deg,#dcfce7,#bbf7d0);color:#052e16;border-bottom-right-radius:4px;}
.hub-msg.ai  .hub-bubble{background:var(--sflo);border-left:2.5px solid var(--p);border-bottom-left-radius:4px;box-shadow:0 1px 6px rgba(0,0,0,.04);}
.hub-msg-label{font-size:10px;font-weight:700;color:var(--p);letter-spacing:.05em;margin-bottom:3px;}
.hub-bubble p{margin:0;}
/* Floating glassmorphism chatbar (overlay — matches course page pattern) */
.hub-input-area{position:absolute;left:0;right:0;bottom:0;z-index:10;
  padding:0 12px 12px;display:flex;justify-content:center;pointer-events:none;}
.hub-input-row{display:flex;align-items:flex-end;gap:6px;padding:6px 6px 6px 16px;
  pointer-events:auto;width:min(795px,92%);
  background:rgba(255,255,255,.78);border:2px solid rgba(255,255,255,.55);border-radius:28px;
  box-shadow:0 8px 40px rgba(0,0,0,.06);
  backdrop-filter:blur(16px) saturate(180%);-webkit-backdrop-filter:blur(16px) saturate(180%);
  transition:border-color .2s,box-shadow .2s;}
.hub-input-row:focus-within{border-color:var(--p);box-shadow:0 4px 28px rgba(0,107,47,.12);}
.hub-input{flex:1;padding:8px 0;border:none;border-radius:0;font-size:15px;font-family:inherit;
  color:var(--ons);background:transparent;outline:none;resize:none;line-height:1.5;
  overflow:hidden;max-height:200px;}
.hub-input:focus{border-color:transparent;}
.hub-input::placeholder{color:var(--ol);opacity:.6;}
.hub-send{width:34px;height:34px;border-radius:50%;background:var(--p);color:#fff;border:none;
  cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;
  transition:background .2s,transform .18s;font-family:inherit;}
.hub-send:hover{background:var(--pb);transform:scale(1.05);}
.hub-send:active{transform:scale(.92);}
.hub-send .material-symbols-outlined{font-size:20px;}
/* Scroll-to-bottom button (replicating course page pattern) */
.hub-scroll-bottom{position:absolute;bottom:calc(100% + 4px);left:50%;z-index:15;
  pointer-events:auto;width:32px;height:32px;border-radius:50%;background:var(--sflo);
  border:1px solid var(--olv);color:var(--ons);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 2px 8px rgba(0,0,0,.1);opacity:0;pointer-events:none;
  transform:translateX(-50%) translateY(8px);
  transition:opacity .25s ease,transform .25s ease,background .2s,color .2s,border-color .2s;}
.hub-scroll-bottom.visible{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto;}
.hub-scroll-bottom:hover{background:var(--p);color:#fff;border-color:var(--p);}
.hub-scroll-bottom .material-symbols-outlined{font-size:18px;}

@keyframes hub-bounce{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-5px)}}
.hub-typing{display:inline-flex;gap:4px;padding:4px 0;align-items:center;}
.hub-typing span{width:6px;height:6px;border-radius:50%;background:var(--p);animation:hub-bounce 1.2s infinite;}
.hub-typing span:nth-child(2){animation-delay:.2s;}
.hub-typing span:nth-child(3){animation-delay:.4s;}
.hub-typing-label{font-size:13px;color:#888;font-style:italic;margin-left:8px;white-space:nowrap;}
@media(prefers-reduced-motion:reduce){.hub-typing span{animation:none!important;opacity:.7;}.hub-typing span:nth-child(2){opacity:.5;}.hub-typing span:nth-child(3){opacity:.3;}}

/* Sessions section */
.hub-sessions-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.hub-sessions-hdr h2{margin:0;font-size:17px;font-weight:700;color:var(--ons);}
.hub-view-all{color:var(--p);font-size:13px;font-weight:600;text-decoration:none;display:flex;align-items:center;gap:3px;}
.hub-view-all .material-symbols-outlined{font-size:15px;}
.hub-sessions-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;}
.hub-session-card{background:var(--sflo);border:1px solid var(--olv);border-radius:var(--r12);padding:16px;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(0,0,0,.04);display:flex;flex-direction:column;gap:8px;}
.hub-session-card:hover{border-color:var(--p);box-shadow:0 4px 16px rgba(0,107,47,.14);transform:translateY(-2px);}
.hub-session-card-hdr{display:flex;align-items:center;justify-content:space-between;}
.hub-course-badge{padding:3px 9px;border-radius:var(--rp);background:var(--secc);color:var(--sec);font-size:11px;font-weight:700;}
.hub-session-time{font-size:11px;color:var(--ol);}
.hub-session-title{font-size:14px;font-weight:700;color:var(--ons);line-height:1.3;}
.hub-session-preview{font-size:12px;color:var(--onsv);line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.hub-session-footer{display:flex;align-items:center;justify-content:space-between;}
.hub-session-meta{font-size:11px;color:var(--ol);display:flex;align-items:center;gap:4px;}
.hub-session-meta .material-symbols-outlined{font-size:13px;}
.hub-session-avatars{display:flex;gap:3px;}
.hub-session-av{width:20px;height:20px;border-radius:50%;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;color:#fff;border:2px solid var(--sflo);}
.hub-av-ai{background:var(--p);}
.hub-av-user{background:var(--sec);}
.hub-session-arrow{color:var(--ol);}
.hub-session-arrow .material-symbols-outlined{font-size:16px;}
.hub-new-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 15px;background:var(--p);color:#fff;border:none;border-radius:var(--r8);font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:background .2s;}
.hub-new-btn .material-symbols-outlined{font-size:16px;}
.hub-new-btn:hover{background:var(--pb);}
.hub-empty{text-align:center;padding:40px;color:var(--ol);background:var(--sflo);border:1px solid var(--olv);border-radius:var(--r16);}
.hub-empty .material-symbols-outlined{font-size:44px;color:var(--olv);display:block;margin-bottom:10px;}
</style>

<div class="hub-root">

  <!-- Top nav -->
  <div class="hub-topnav">
    <div class="hub-brand">UMaT Moodle<span>AI Enhanced Learning</span></div>
    <div style="font-size:16px;font-weight:800;color:var(--p);white-space:nowrap;">UMaT AI Assistant</div>
    <div class="hub-nav-tabs">
      <a class="hub-nav-tab active" href="{{wwwroot}}/local/umat_ai/hub.php">Dashboard</a>
      <a class="hub-nav-tab" href="{{wwwroot}}/my/">Courses</a>
      <a class="hub-nav-tab" href="{{wwwroot}}/local/umat_ai/hub.php#logs">Session Logs</a>
      <a class="hub-nav-tab" href="{{wwwroot}}/my/">Analytics</a>
    </div>
    <div class="hub-search">
      <span class="material-symbols-outlined">search</span>
      <input type="text" id="hub-search-input" placeholder="Search sessions…">
    </div>
    <button class="hub-icon-btn" type="button"><span class="material-symbols-outlined">notifications</span></button>
    <button class="hub-icon-btn" type="button"><span class="material-symbols-outlined">settings</span></button>
    <div class="hub-avatar-pill">{{user_initials}}</div>
  </div>

  <div class="hub-body">
    <!-- Sidebar -->
    <div class="hub-sb">
      <div class="hub-sb-logo">
        <div class="hub-sb-logo-icon"><span class="material-symbols-outlined">school</span></div>
        <div class="hub-sb-logo-text"><strong>UMaT Moodle</strong><span>AI Enhanced Learning</span></div>
      </div>
      <nav class="hub-sb-nav">
        <a class="hub-sb-item" href="{{wwwroot}}"><span class="material-symbols-outlined">home</span><span class="hub-sb-item-lbl">Home</span></a>
        <a class="hub-sb-item" href="{{wwwroot}}/my/"><span class="material-symbols-outlined">menu_book</span><span class="hub-sb-item-lbl">My Courses</span></a>
        <a class="hub-sb-item active" href="{{wwwroot}}/local/umat_ai/hub.php"><span class="material-symbols-outlined">smart_toy</span><span class="hub-sb-item-lbl">AI Tutor</span></a>
        <a class="hub-sb-item" href="{{wwwroot}}/my/"><span class="material-symbols-outlined">bar_chart</span><span class="hub-sb-item-lbl">Analytics</span></a>
        <a class="hub-sb-item" href="{{wwwroot}}/my/"><span class="material-symbols-outlined">local_library</span><span class="hub-sb-item-lbl">Resource Materials</span></a>
      </nav>
      <div class="hub-sb-divider"></div>
      <button class="hub-sb-new" id="hub-new-session-btn" type="button">
        <span class="material-symbols-outlined">add</span>
        <span class="hub-sb-new-lbl">New AI Session</span>
      </button>
      <div class="hub-sb-footer">
        <a class="hub-sb-item" href="{{wwwroot}}"><span class="material-symbols-outlined">help_outline</span><span class="hub-sb-item-lbl">Help</span></a>
        <a class="hub-sb-item" href="{{wwwroot}}/login/logout.php"><span class="material-symbols-outlined">logout</span><span class="hub-sb-item-lbl">Sign Out</span></a>
      </div>
    </div>

    <!-- Main scrollable -->
    <div class="hub-main">

      <!-- Stats strip -->
      <div class="hub-stats">
        <div class="hub-stat-card">
          <div class="hub-stat-icon" style="background:rgba(0,107,47,.1);color:var(--p);"><span class="material-symbols-outlined">forum</span></div>
          <div><div class="hub-stat-val">{{week_sessions}}</div><div class="hub-stat-lbl">Sessions this week</div></div>
        </div>
        <div class="hub-stat-card">
          <div class="hub-stat-icon" style="background:rgba(61,104,68,.1);color:var(--sec);"><span class="material-symbols-outlined">help</span></div>
          <div><div class="hub-stat-val">{{week_questions}}</div><div class="hub-stat-lbl">Questions asked</div></div>
        </div>
        <div class="hub-stat-card">
          <div class="hub-stat-icon" style="background:rgba(165,48,77,.1);color:var(--ter);"><span class="material-symbols-outlined">bolt</span></div>
          <div><div class="hub-stat-val">{{goalprogress}}%</div><div class="hub-stat-lbl">Weekly goal</div></div>
        </div>
      </div>

      <!-- Bento grid -->
      <div class="hub-bento">
        <!-- Learning Pulse -->
        <div class="hub-card">
          <div class="hub-card-hdr">
            <h2 class="hub-card-title"><span class="material-symbols-outlined">bolt</span>Learning Pulse</h2>
            <span class="material-symbols-outlined" style="color:var(--p);cursor:pointer;">bolt</span>
          </div>
          <div class="hub-card-body">
            <p style="font-size:13px;color:var(--onsv);margin:0 0 12px;">Your most focused topics this semester based on AI interactions.</p>
            <div class="hub-topic-tags">
              {{#pulse_topics}}
              <span class="hub-topic-tag"><span class="material-symbols-outlined">school</span>{{label}}</span>
              {{/pulse_topics}}
              {{^pulse_topics}}
              <span style="font-size:13px;color:var(--ol);">Start using the AI assistant to see your top topics here.</span>
              {{/pulse_topics}}
            </div>
            <div class="hub-goal-section">
              <div class="hub-goal-row"><span>Study Goal Progress</span><strong>{{goalprogress}}%</strong></div>
              <div class="hub-goal-bar"><div class="hub-goal-fill" style="width:{{goalprogress}}%;"></div></div>
              <div class="hub-goal-sub">Goal: 20 AI interactions per week</div>
            </div>
          </div>
        </div>

        <!-- General Assistant Chat -->
        <div class="hub-card">
          <div class="hub-chat">
            <div class="hub-chat-hdr">
              <div class="hub-chat-icon"><span class="material-symbols-outlined">forum</span></div>
              <div>
                <div class="hub-chat-title">General Assistant</div>
                <div class="hub-chat-sub"><span style="width:6px;height:6px;border-radius:50%;background:#4ade80;display:inline-block;"></span>AI READY</div>
              </div>
              <select class="hub-course-sel" id="hub-course-sel">
                <option value="{{first_courseid}}">All Courses</option>
                {{#courses}}<option value="{{id}}">{{shortname}} — {{fullname}}</option>{{/courses}}
              </select>
              <button class="hub-chat-expand" title="Expand" type="button"><span class="material-symbols-outlined">open_in_full</span></button>
            </div>
            <div class="hub-msgs" id="hub-msgs">
              <div class="hub-msg ai">
                <div class="hub-msg-label">AI TUTOR</div>
                <div class="hub-bubble"><p>Welcome back, <strong>{{username}}</strong>. How can I assist with your engineering studies or UMaT campus inquiries today?</p></div>
              </div>
            </div>
            <div class="hub-input-area">
              <button class="hub-scroll-bottom" id="hub-scroll-bottom" type="button"><span class="material-symbols-outlined">expand_more</span></button>
              <div class="hub-input-row">
                <textarea id="hub-chat-input" class="hub-input" placeholder="Ask anything about your courses or campus…" rows="1" maxlength="900"></textarea>
                <button class="hub-send" id="hub-chat-send" type="button">
                  <span class="material-symbols-outlined">arrow_upward</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div><!-- /bento -->

      <!-- Recent Session Logs -->
      <div id="recent-sessions-section">
        <div class="hub-sessions-hdr">
          <h2>Recent Session Logs</h2>
          <div style="display:flex;align-items:center;gap:12px;">
            <a href="{{wwwroot}}/local/umat_ai/hub.php" class="hub-view-all">View all logs<span class="material-symbols-outlined">arrow_forward</span></a>
            <button class="hub-new-btn" id="hub-new-btn" type="button"><span class="material-symbols-outlined">add</span>New AI Session</button>
          </div>
        </div>

        {{#has_sessions}}
        <div class="hub-sessions-grid" id="hub-sessions-grid">
          {{#recent_sessions}}
          <div class="hub-session-card" data-session="{{session_key}}" data-course="{{courseid}}">
            <div class="hub-session-card-hdr">
              <span class="hub-course-badge">{{course_short}}</span>
              <span class="hub-session-time">{{time_label}}</span>
            </div>
            <div class="hub-session-title">{{course_name}} AI Review</div>
            <div class="hub-session-preview">{{preview}}</div>
            <div class="hub-session-footer">
              <div class="hub-session-meta"><span class="material-symbols-outlined">chat</span>{{msg_count}} messages</div>
              <div class="hub-session-avatars">
                <div class="hub-session-av hub-av-ai">AI</div>
                <div class="hub-session-av hub-av-user">MK</div>
              </div>
              <div class="hub-session-arrow"><span class="material-symbols-outlined">arrow_forward_ios</span></div>
            </div>
          </div>
          {{/recent_sessions}}
        </div>
        {{/has_sessions}}
        {{^has_sessions}}
        <div class="hub-empty">
          <span class="material-symbols-outlined">history</span>
          <p>No past sessions yet. Start a conversation above to get going!</p>
        </div>
        {{/has_sessions}}
      </div>

    </div><!-- /hub-main -->
  </div><!-- /hub-body -->
</div><!-- /hub-root -->

<script>
(function() {
  'use strict';
  var firstCourseId = {{first_courseid}};
  var sel           = document.getElementById('hub-course-sel');
  var msgs          = document.getElementById('hub-msgs');

  function esc(s) { var d=document.createElement('div');d.appendChild(document.createTextNode(s));return d.innerHTML; }

  function appendMsg(text, isUser) {
    var d = document.createElement('div');
    if (isUser) {
      d.innerHTML = '<div class="hub-msg user"><div class="hub-bubble"><p>'+esc(text)+'</p></div></div>';
    } else {
      d.innerHTML = '<div class="hub-msg ai"><div class="hub-msg-label">AI TUTOR</div><div class="hub-bubble"><p>'+esc(text)+'</p></div></div>';
    }
    msgs.appendChild(d);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function showTyping() {
    var d = document.createElement('div');
    d.id = 'hub-typing-el';
    d.setAttribute('role', 'status');
    d.setAttribute('aria-live', 'polite');
    d.setAttribute('aria-label', 'AI is preparing a response');
    d.innerHTML = '<div class="hub-msg ai"><div class="hub-msg-label">AI TUTOR</div><div class="hub-bubble"><div class="hub-typing" aria-hidden="true"><span></span><span></span><span></span></div><span class="hub-typing-label">AI is responding&hellip;</span></div></div>';
    msgs.appendChild(d);
    msgs.scrollTop = msgs.scrollHeight;
  }
  function hideTyping() { var el=document.getElementById('hub-typing-el');if(el)el.parentNode.removeChild(el); }

  function sendMsg(q) {
    q = (q||'').trim();
    if (!q) return;
    appendMsg(q, true);
    var inp=document.getElementById('hub-chat-input');if(inp){inp.value='';inp.style.height='auto';}
    showTyping();

    // Disable send button during request
    var sendBtn = document.getElementById('hub-chat-send');
    var chatInp = document.getElementById('hub-chat-input');
    if (sendBtn) { sendBtn.disabled = true; sendBtn.setAttribute('aria-busy', 'true'); }
    if (chatInp) chatInp.disabled = true;

    var cid = parseInt((sel && sel.value) || firstCourseId) || 0;
    if (!cid) {
      hideTyping();
      appendMsg('Please select a course first.', false);
      if (sendBtn) { sendBtn.disabled = false; sendBtn.removeAttribute('aria-busy'); }
      if (chatInp) chatInp.disabled = false;
      return;
    }

    require(['core/ajax'], function(Ajax) {
      Ajax.call([{ methodname:'local_umat_ai_ask_question', args:{courseid:cid, question:q, session_key:''} }])[0]
        .done(function(r){
          hideTyping();
          appendMsg(r.success ? r.answer : 'Sorry, an error occurred. Please try again.', false);
          if (sendBtn) { sendBtn.disabled = false; sendBtn.removeAttribute('aria-busy'); }
          if (chatInp) { chatInp.disabled = false; chatInp.focus(); }
        })
        .fail(function(){
          hideTyping();
          appendMsg('Connection error. Please check your network.', false);
          if (sendBtn) { sendBtn.disabled = false; sendBtn.removeAttribute('aria-busy'); }
          if (chatInp) { chatInp.disabled = false; chatInp.focus(); }
        });
    });
  }

  var sendBtn = document.getElementById('hub-chat-send');
  var chatInput = document.getElementById('hub-chat-input');
  if (sendBtn) sendBtn.addEventListener('click', function(){ if(this.disabled)return; sendMsg(chatInput.value); });
  if (chatInput) {
    chatInput.addEventListener('keydown', function(e){
      if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();if(sendBtn&&!sendBtn.disabled)sendMsg(this.value);}
    });
    /* auto-resize */
    chatInput.addEventListener('input', function(){
      this.style.height='auto';this.style.height=Math.min(this.scrollHeight,200)+'px';
    });
  }
  /* scroll-to-bottom button */
  (function(){
    var sb=document.getElementById('hub-scroll-bottom');
    if(!msgs||!sb)return;
    var st=null;
    msgs.addEventListener('scroll',function(){
      if(st)clearTimeout(st);
      st=setTimeout(function(){
        var nb=msgs.scrollHeight-msgs.scrollTop-msgs.clientHeight<100;
        sb.classList.toggle('visible',!nb);
      },80);
    });
    sb.addEventListener('click',function(){
      msgs.scrollTo({top:msgs.scrollHeight,behavior:'smooth'});
    });
    var mo=new MutationObserver(function(){
      var nb=msgs.scrollHeight-msgs.scrollTop-msgs.clientHeight<100;
      sb.classList.toggle('visible',!nb);
    });
    mo.observe(msgs,{childList:true,subtree:false});
  })();

  /* New session */
  var newBtn = document.getElementById('hub-new-btn');
  var newSbBtn = document.getElementById('hub-new-session-btn');
  function newSession() {
    msgs.innerHTML = '<div class="hub-msg ai"><div class="hub-msg-label">AI TUTOR</div><div class="hub-bubble"><p>New conversation started! What would you like to explore?</p></div></div>';
    if (chatInput) chatInput.focus();
  }
  if (newBtn) newBtn.addEventListener('click', newSession);
  if (newSbBtn) newSbBtn.addEventListener('click', newSession);

  /* Session card click — resume session */
  document.querySelectorAll('.hub-session-card').forEach(function(card) {
    card.addEventListener('click', function() {
      var cid = parseInt(card.dataset.course)||0;
      if (sel && cid) sel.value = cid;
      msgs.innerHTML = '<div class="hub-msg ai"><div class="hub-msg-label">AI TUTOR</div><div class="hub-bubble"><p>Resuming your previous session. What would you like to continue exploring?</p></div></div>';
      if (chatInput) chatInput.focus();
    });
  });

  /* Search filter for session cards */
  var searchInput = document.getElementById('hub-search-input');
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      var q = this.value.toLowerCase();
      document.querySelectorAll('.hub-session-card').forEach(function(card) {
        var text = card.textContent.toLowerCase();
        card.style.display = !q || text.includes(q) ? '' : 'none';
      });
    });
  }
})();
</script>
