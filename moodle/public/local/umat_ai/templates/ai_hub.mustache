{{!
    Template: local/umat_ai/templates/ai_hub.mustache
    General AI Learning Hub — cross-course AI conversations and session logs.

    Context:
      wwwroot, userid, username
      goalprogress (int 0-100)
      week_sessions, week_questions
      courses (array: id, fullname, shortname)
      recent_sessions (array: session_key, courseid, course_name, course_short, time_label, msg_count, preview)
      pulse_topics (array: label, count)
      has_sessions (bool), has_courses (bool)
}}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200">

<style>
:root{--p:#006b2f;--pb:#00873d;--op:#ffffff;--sf:#f5fbf0;--sfl:#eff6eb;--sflo:#ffffff;--ons:#171d17;--onsv:#3e4a3e;--ol:#6e7a6d;--olv:#bdcaba;--sec:#3d6844;--secc:#beefc1;--ter:#a5304d;--r8:8px;--r12:12px;--r16:16px;--r20:20px;}
.umat-hub{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;max-width:1280px;margin:0 auto;padding:24px 20px 80px;color:var(--ons);}

/* Header */
.umat-hub-header{margin-bottom:28px;}
.umat-hub-header h1{margin:0 0 4px;font-size:26px;font-weight:800;color:var(--p);}
.umat-hub-header p{margin:0;font-size:14px;color:var(--onsv);}

/* Week stats strip */
.umat-week-strip{display:flex;gap:12px;margin-bottom:28px;flex-wrap:wrap;}
.umat-week-card{background:var(--sflo);border:1px solid var(--olv);border-radius:var(--r12);padding:14px 20px;display:flex;align-items:center;gap:12px;flex:1;min-width:160px;}
.umat-week-card .icon{width:36px;height:36px;border-radius:var(--r8);background:rgba(0,107,47,.1);color:var(--p);display:flex;align-items:center;justify-content:center;}
.umat-week-card .icon .material-symbols-outlined{font-size:20px;}
.umat-week-card .val{font-size:22px;font-weight:800;color:var(--ons);line-height:1;}
.umat-week-card .lbl{font-size:11px;color:var(--ol);margin-top:2px;}

/* Bento grid */
.umat-hub-grid{display:grid;grid-template-columns:320px 1fr;gap:20px;margin-bottom:28px;}
@media(max-width:900px){.umat-hub-grid{grid-template-columns:1fr;}}

/* Card */
.umat-hub-card{background:var(--sflo);border:1px solid var(--olv);border-radius:var(--r16);overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.05);}
.umat-hub-card-header{padding:14px 20px;border-bottom:1px solid var(--olv);display:flex;align-items:center;justify-content:space-between;}
.umat-hub-card-title{margin:0;font-size:15px;font-weight:700;color:var(--ons);display:flex;align-items:center;gap:7px;}
.umat-hub-card-title .material-symbols-outlined{font-size:18px;color:var(--p);}
.umat-hub-card-body{padding:20px;}

/* Topic pills */
.umat-topic-tags{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:16px;}
.umat-topic-tag{padding:5px 13px;border-radius:999px;background:var(--secc);color:var(--sec);font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:4px;}
.umat-topic-tag .material-symbols-outlined{font-size:13px;}

/* Goal bar */
.umat-goal-section{border-top:1px solid var(--olv);padding-top:14px;}
.umat-goal-label{display:flex;justify-content:space-between;font-size:12px;color:var(--onsv);margin-bottom:6px;}
.umat-goal-label strong{color:var(--p);}
.umat-goal-bar{height:8px;background:var(--sfl);border-radius:4px;overflow:hidden;}
.umat-goal-fill{height:100%;background:linear-gradient(90deg,var(--p),var(--pb));border-radius:4px;transition:width .5s ease;}

/* Chat area */
.umat-hub-chat{display:flex;flex-direction:column;height:500px;}
.umat-hub-chat-header{padding:14px 20px;border-bottom:1px solid var(--olv);display:flex;align-items:center;gap:12px;background:var(--sflo);}
.umat-hub-chat-icon{width:36px;height:36px;background:rgba(0,107,47,.1);border-radius:var(--r8);display:flex;align-items:center;justify-content:center;color:var(--p);}
.umat-hub-chat-icon .material-symbols-outlined{font-size:20px;}
.umat-course-select{margin-left:auto;padding:7px 11px;border:1px solid var(--olv);border-radius:var(--r8);font-size:13px;color:var(--ons);background:var(--sflo);cursor:pointer;font-family:inherit;}
.umat-hub-messages{flex:1;overflow-y:auto;padding:18px;background:var(--sf);display:flex;flex-direction:column;gap:14px;}
.umat-hub-messages::-webkit-scrollbar{width:5px;}
.umat-hub-messages::-webkit-scrollbar-thumb{background:var(--olv);border-radius:4px;}
.umat-hub-msg{max-width:80%;}
.umat-hub-msg.user{align-self:flex-end;}
.umat-hub-msg.ai{align-self:flex-start;}
.umat-hub-bubble{padding:12px 16px;border-radius:var(--r12);font-size:14px;line-height:1.55;}
.umat-hub-msg.user .umat-hub-bubble{background:linear-gradient(135deg,#dcfce7,#bbf7d0);color:#052e16;border-bottom-right-radius:4px;}
.umat-hub-msg.ai .umat-hub-bubble{background:var(--sflo);border-left:3px solid var(--p);border-bottom-left-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,.05);}
.umat-hub-bubble p{margin:0;}
.umat-hub-input-area{padding:14px 18px;border-top:1px solid var(--olv);background:var(--sflo);}
.umat-hub-input-row{display:flex;gap:10px;}
.umat-hub-input{flex:1;padding:10px 14px;border:1.5px solid var(--olv);border-radius:var(--r8);font-size:14px;font-family:inherit;color:var(--ons);background:var(--sf);outline:none;transition:border-color .2s;}
.umat-hub-input:focus{border-color:var(--p);}
.umat-hub-send{padding:10px 20px;background:var(--p);color:var(--op);border:none;border-radius:var(--r8);font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;transition:background .2s;font-family:inherit;}
.umat-hub-send .material-symbols-outlined{font-size:18px;}
.umat-hub-send:hover{background:var(--pb);}

/* Typing */
@keyframes hub-bounce{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-5px)}}
.hub-typing{display:flex;gap:4px;padding:6px 0;}
.hub-typing span{width:7px;height:7px;border-radius:50%;background:var(--p);animation:hub-bounce 1.2s infinite;}
.hub-typing span:nth-child(2){animation-delay:.2s;}
.hub-typing span:nth-child(3){animation-delay:.4s;}

/* Session cards */
.umat-sessions-section{margin-top:8px;}
.umat-sessions-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
.umat-sessions-title{margin:0;font-size:18px;font-weight:700;color:var(--ons);}
.umat-sessions-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;}
.umat-session-card{background:var(--sflo);border:1px solid var(--olv);border-radius:var(--r12);padding:18px;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(0,0,0,.04);}
.umat-session-card:hover{border-color:var(--p);box-shadow:0 4px 16px rgba(0,107,47,.15);transform:translateY(-2px);}
.umat-session-card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
.umat-course-badge{padding:4px 10px;border-radius:999px;background:var(--secc);color:var(--sec);font-size:11px;font-weight:700;}
.umat-session-time{font-size:11px;color:var(--ol);}
.umat-session-preview{font-size:13px;color:var(--onsv);line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:8px;}
.umat-session-meta{font-size:11px;color:var(--ol);display:flex;align-items:center;gap:4px;}
.umat-session-meta .material-symbols-outlined{font-size:14px;}

.umat-btn-new{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:var(--p);color:var(--op);border:none;border-radius:var(--r8);font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:background .2s;}
.umat-btn-new .material-symbols-outlined{font-size:16px;}
.umat-btn-new:hover{background:var(--pb);}

.umat-no-sessions{text-align:center;padding:40px;background:var(--sflo);border:1px solid var(--olv);border-radius:var(--r16);color:var(--ol);}
.umat-no-sessions .material-symbols-outlined{font-size:48px;color:var(--olv);display:block;margin-bottom:10px;}
</style>

<div class="umat-hub">

  <!-- ================================================================ -->
  <!-- Header                                                            -->
  <!-- ================================================================ -->
  <div class="umat-hub-header">
    <h1>{{#str}}ai_hub_title, local_umat_ai{{/str}}</h1>
    <p>Welcome back, <strong>{{username}}</strong> — your AI learning companion across all courses.</p>
  </div>

  <!-- ================================================================ -->
  <!-- Week stats strip                                                  -->
  <!-- ================================================================ -->
  <div class="umat-week-strip">
    <div class="umat-week-card">
      <div class="icon"><span class="material-symbols-outlined">forum</span></div>
      <div>
        <div class="val">{{week_sessions}}</div>
        <div class="lbl">{{#str}}sessions_this_week, local_umat_ai{{/str}}</div>
      </div>
    </div>
    <div class="umat-week-card">
      <div class="icon" style="background:rgba(61,104,68,.1);color:var(--sec);">
        <span class="material-symbols-outlined">help</span>
      </div>
      <div>
        <div class="val">{{week_questions}}</div>
        <div class="lbl">{{#str}}questions_asked, local_umat_ai{{/str}}</div>
      </div>
    </div>
    <div class="umat-week-card">
      <div class="icon" style="background:rgba(165,48,77,.1);color:var(--ter);">
        <span class="material-symbols-outlined">bolt</span>
      </div>
      <div>
        <div class="val">{{goalprogress}}%</div>
        <div class="lbl">Weekly goal progress</div>
      </div>
    </div>
  </div>

  <!-- ================================================================ -->
  <!-- Bento grid: Learning Pulse | General Chat                         -->
  <!-- ================================================================ -->
  <div class="umat-hub-grid">

    <!-- ---- Learning Pulse ---- -->
    <div class="umat-hub-card">
      <div class="umat-hub-card-header">
        <h2 class="umat-hub-card-title">
          <span class="material-symbols-outlined">bolt</span>
          {{#str}}learning_pulse, local_umat_ai{{/str}}
        </h2>
      </div>
      <div class="umat-hub-card-body">
        <p style="font-size:13px;color:var(--onsv);margin:0 0 14px;">Your most active subjects this semester.</p>

        <div class="umat-topic-tags" id="hub-topic-tags">
          {{#pulse_topics}}
          <span class="umat-topic-tag">
            <span class="material-symbols-outlined">school</span>
            {{label}}
          </span>
          {{/pulse_topics}}
          {{^pulse_topics}}
          <span style="font-size:13px;color:var(--ol);">Start asking AI questions to see your top topics here.</span>
          {{/pulse_topics}}
        </div>

        <div class="umat-goal-section">
          <div class="umat-goal-label">
            <span>{{#str}}study_goal, local_umat_ai{{/str}}</span>
            <strong>{{goalprogress}}%</strong>
          </div>
          <div class="umat-goal-bar">
            <div class="umat-goal-fill" style="width:{{goalprogress}}%;"></div>
          </div>
          <p style="font-size:11px;color:var(--ol);margin:8px 0 0;">Goal: 20 AI interactions per week</p>
        </div>
      </div>
    </div>

    <!-- ---- General Chat ---- -->
    <div class="umat-hub-card">
      <div class="umat-hub-chat">
        <div class="umat-hub-chat-header">
          <div class="umat-hub-chat-icon">
            <span class="material-symbols-outlined">forum</span>
          </div>
          <span style="font-size:15px;font-weight:700;">{{#str}}general_chat, local_umat_ai{{/str}}</span>
          <select class="umat-course-select" id="hub-course-select">
            <option value="0">{{#str}}all_courses, local_umat_ai{{/str}}</option>
            {{#courses}}
            <option value="{{id}}">{{shortname}} — {{fullname}}</option>
            {{/courses}}
          </select>
        </div>

        <div class="umat-hub-messages" id="hub-messages">
          <div class="umat-hub-msg ai">
            <div class="umat-hub-bubble">
              <p>{{#str}}hub_greeting, local_umat_ai{{/str}}</p>
            </div>
          </div>
        </div>

        <div class="umat-hub-input-area">
          <div class="umat-hub-input-row">
            <input
              type="text"
              id="hub-question-input"
              class="umat-hub-input"
              placeholder="{{#str}}ask_placeholder, local_umat_ai{{/str}}"
              maxlength="600"
              autocomplete="off"
            >
            <button class="umat-hub-send" id="hub-send-btn" type="button">
              <span class="material-symbols-outlined">send</span>
              {{#str}}send, local_umat_ai{{/str}}
            </button>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /bento grid -->

  <!-- ================================================================ -->
  <!-- Recent Sessions                                                   -->
  <!-- ================================================================ -->
  <div class="umat-sessions-section">
    <div class="umat-sessions-header">
      <h2 class="umat-sessions-title">{{#str}}recent_sessions, local_umat_ai{{/str}}</h2>
      <button class="umat-btn-new" id="hub-new-session" type="button">
        <span class="material-symbols-outlined">add</span>
        {{#str}}new_session, local_umat_ai{{/str}}
      </button>
    </div>

    {{#has_sessions}}
    <div class="umat-sessions-grid" id="hub-sessions-grid">
      {{#recent_sessions}}
      <div class="umat-session-card" data-session-key="{{session_key}}" data-courseid="{{courseid}}">
        <div class="umat-session-card-head">
          <span class="umat-course-badge">{{course_short}}</span>
          <span class="umat-session-time">{{time_label}}</span>
        </div>
        <div class="umat-session-preview">{{preview}}</div>
        <div class="umat-session-meta">
          <span class="material-symbols-outlined">chat</span>
          {{msg_count}} messages
        </div>
      </div>
      {{/recent_sessions}}
    </div>
    {{/has_sessions}}

    {{^has_sessions}}
    <div class="umat-no-sessions">
      <span class="material-symbols-outlined">history</span>
      <p>No past sessions yet. Start a conversation above to get going!</p>
    </div>
    {{/has_sessions}}
  </div>

</div><!-- /umat-hub -->

<script>
document.addEventListener('DOMContentLoaded', function() {
  'use strict';

  var sendBtn     = document.getElementById('hub-send-btn');
  var input       = document.getElementById('hub-question-input');
  var messages    = document.getElementById('hub-messages');
  var courseSelect= document.getElementById('hub-course-select');
  var wwwroot     = '{{wwwroot}}';

  function escHtml(s) {
    var d = document.createElement('div');
    d.appendChild(document.createTextNode(s));
    return d.innerHTML;
  }

  function addMessage(text, isUser) {
    var div = document.createElement('div');
    div.className = 'umat-hub-msg ' + (isUser ? 'user' : 'ai');
    div.innerHTML = '<div class="umat-hub-bubble"><p>' + escHtml(text) + '</p></div>';
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function showTyping() {
    var div = document.createElement('div');
    div.id  = 'hub-typing';
    div.className = 'umat-hub-msg ai';
    div.innerHTML = '<div class="umat-hub-bubble"><div class="hub-typing"><span></span><span></span><span></span></div></div>';
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }
  function hideTyping() {
    var el = document.getElementById('hub-typing');
    if (el) el.parentNode.removeChild(el);
  }

  function sendQuestion(q) {
    q = (q || '').trim();
    if (!q) return;
    addMessage(q, true);
    input.value = '';
    showTyping();

    var selectedCourse = parseInt(courseSelect.value) || 0;
    // Fall back to the first enrolled course if "All Courses" is selected.
    var courseId = selectedCourse > 0 ? selectedCourse : ({{#has_courses}}{{#courses}}{{id}}{{/courses}}{{/has_courses}}0);

    require(['core/ajax'], function(Ajax) {
      Ajax.call([{
        methodname: 'local_umat_ai_ask_question',
        args: { courseid: courseId, question: q, session_key: '' }
      }])[0].done(function(r) {
        hideTyping();
        addMessage(r.success ? r.answer : '{{#str}}error_message, local_umat_ai{{/str}}', false);
      }).fail(function() {
        hideTyping();
        addMessage('{{#str}}connection_error, local_umat_ai{{/str}}', false);
      });
    });
  }

  if (sendBtn) sendBtn.addEventListener('click', function() { sendQuestion(input.value); });
  if (input)   input.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); sendQuestion(input.value); }
  });

  /* New session button — clear messages and focus */
  var newBtn = document.getElementById('hub-new-session');
  if (newBtn) {
    newBtn.addEventListener('click', function() {
      messages.innerHTML = '<div class="umat-hub-msg ai"><div class="umat-hub-bubble"><p>New conversation started! What would you like to explore?</p></div></div>';
      if (input) input.focus();
    });
  }

  /* Session card click — resume in chat */
  document.querySelectorAll('.umat-session-card').forEach(function(card) {
    card.addEventListener('click', function() {
      var sessionKey = card.dataset.sessionKey;
      var courseId   = parseInt(card.dataset.courseid) || 0;
      if (courseId) courseSelect.value = courseId;
      messages.innerHTML = '<div class="umat-hub-msg ai"><div class="umat-hub-bubble"><p>Resuming previous session. Ask your next question to continue.</p></div></div>';
      if (input) { input.focus(); input.setAttribute('data-session-key', sessionKey); }
    });
  });
});
</script>
