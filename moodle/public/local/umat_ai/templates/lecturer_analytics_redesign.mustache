{{!
    Template: local/umat_ai/templates/lecturer_analytics_redesign.mustache
    Lecturer Analytics Dashboard — Redesign v2 (glassmorphism + Material hybrid).

    Layout (mobile-first, priority above the fold):
      1. KPI strip         – 5 KPI cards (students, at-risk, quiz avg, active, questions)
      2. NLG insights      – natural-language insight cards (AI or template generated)
      3. Priority actions  – what needs attention right now
      4. Charts row        – Performance trend (ECharts line) | Risk donut | Topic heatmap
      5. Students row      – At-risk students | What Students Are Asking
      6. Secondary row     – Quiz analytics | Recording engagement | Resource engagement
      (Course selector lives in the overlay header; refresh lives in the
      "What Needs Your Attention" section header — the standalone nav bar
      was removed on request.)
      (NLQ removed: "Ask About Your Students" now lives in the Ask AI Assistant FAB)

    All content is rendered by the AMD module (local_umat_ai/lecturer_analytics)
    from the consolidated API (local_umat_ai_get_analytics_data).

    Context (provided by JS): courseid, coursefullname
}}
<div class="la-dashboard" id="la-dashboard" data-courseid="{{{courseid}}}">

  <!-- ═══════════════════ KPI STRIP ═══════════════════ -->
  <section class="la-kpi-strip" id="la-kpi-strip" aria-label="Course key indicators">
    <div class="la-skeleton la-skeleton-kpi" data-skel="kpi"></div>
    <div class="la-skeleton la-skeleton-kpi" data-skel="kpi"></div>
    <div class="la-skeleton la-skeleton-kpi" data-skel="kpi"></div>
    <div class="la-skeleton la-skeleton-kpi" data-skel="kpi"></div>
    <div class="la-skeleton la-skeleton-kpi" data-skel="kpi"></div>
  </section>

  <!-- ═══════════════════ EXECUTIVE BRIEFING ═══════════════════ -->
  <section class="la-briefing" id="la-briefing">
    <div class="la-briefing-grade" id="la-briefing-grade">
      <span class="la-grade-letter" id="la-grade-letter">—</span>
      <span class="la-grade-label">Health</span>
    </div>
    <div class="la-briefing-text">
      <p class="la-briefing-summary" id="la-briefing-summary">Loading executive summary…</p>
      <p class="la-briefing-reco" id="la-briefing-reco"></p>
    </div>
    <div class="la-skeleton la-skeleton-brief" data-skel="brief"></div>
  </section>

  <!-- ═══════════════════ NLG INSIGHTS ═══════════════════ -->
  <section class="la-insights" id="la-insights" aria-label="AI insights">
    <h3 class="la-section-title">
      <span class="material-symbols-outlined">auto_awesome</span>
      What Needs Your Attention
      <span class="la-pill" id="la-insights-source">AI-generated</span>
      <button class="la-btn la-btn-icon" id="la-refresh-btn" type="button" title="Refresh data" aria-label="Refresh data">
        <span class="material-symbols-outlined" id="la-refresh-icon">refresh</span>
      </button>
    </h3>
    <div class="la-insight-list" id="la-insight-list"></div>
  </section>

  <!-- ═══════════════════ PRIORITY ACTIONS ═══════════════════ -->
  <section class="la-priority" id="la-priority">
    <h3 class="la-section-title">
      <span class="material-symbols-outlined">flag</span>
      Priority Actions
    </h3>
    <div class="la-priority-list" id="la-priority-list"></div>
    <div class="la-skeleton la-skeleton-block" data-skel="priority"></div>
  </section>

  <!-- ═══════════════════ CHARTS ROW (3 cards) ═══════════════════ -->
  <section class="la-grid">
    <!-- Performance trend -->
    <div class="la-card la-card-chart" id="la-card-trend">
      <div class="la-card-header">
        <h3><span class="material-symbols-outlined">show_chart</span> Performance Trend</h3>
        <span class="la-trend-caption" id="la-trend-caption"></span>
      </div>
      <div class="la-card-body">
        <div class="la-chart" id="la-performance-chart" role="img" aria-label="Class performance trend"></div>
      </div>
      <div class="la-skeleton la-skeleton-chart" data-skel="trend"></div>
    </div>

    <!-- Risk distribution donut -->
    <div class="la-card la-card-chart" id="la-card-risk">
      <div class="la-card-header">
        <h3><span class="material-symbols-outlined">pie_chart</span> Risk Distribution</h3>
        <span class="la-legend-dots" id="la-risk-legend"></span>
      </div>
      <div class="la-card-body">
        <div class="la-chart" id="la-risk-chart" role="img" aria-label="Student risk distribution"></div>
      </div>
      <div class="la-skeleton la-skeleton-chart" data-skel="risk"></div>
    </div>

    <!-- Topic struggle heatmap -->
    <div class="la-card la-card-chart" id="la-card-topics">
      <div class="la-card-header">
        <h3><span class="material-symbols-outlined">grid_on</span> Topic Struggle</h3>
        <span class="la-trend-caption">Struggle score by topic</span>
      </div>
      <div class="la-card-body">
        <div class="la-chart" id="la-topic-heatmap" role="img" aria-label="Topic struggle heatmap"></div>
      </div>
      <div class="la-skeleton la-skeleton-chart" data-skel="topics"></div>
    </div>
  </section>

  <!-- ═══════════════════ STUDENTS ROW (2 cards) ═══════════════════ -->
  <section class="la-grid la-grid-duo">
    <!-- At-risk students -->
    <div class="la-card la-card-students" id="la-card-students">
      <div class="la-card-header">
        <h3><span class="material-symbols-outlined">groups</span> At-Risk Students
          <span class="la-badge" id="la-at-risk-count">0</span>
        </h3>
        <div class="la-filter-row" id="la-filters">
          <button class="la-chip la-chip-active" data-filter="all" type="button">All</button>
          <button class="la-chip" data-filter="critical" type="button">Critical</button>
          <button class="la-chip" data-filter="warning" type="button">Warning</button>
        </div>
      </div>
      <div class="la-card-body">
        <div class="la-student-list" id="la-student-list">
          <div class="la-empty">No student data loaded yet.</div>
        </div>
      </div>
      <div class="la-skeleton la-skeleton-students" data-skel="students"></div>
    </div>

    <!-- Common questions -->
    <div class="la-card" id="la-card-questions">
      <div class="la-card-header">
        <h3><span class="material-symbols-outlined">question_answer</span> What Students Are Asking</h3>
      </div>
      <div class="la-card-body">
        <div class="la-question-list" id="la-common-questions"></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ SECONDARY ROW (3 cards) ═══════════════════ -->
  <section class="la-grid la-grid-secondary">
    <!-- Quiz analytics -->
    <div class="la-card" id="la-card-quiz">
      <div class="la-card-header">
        <h3><span class="material-symbols-outlined">quiz</span> Quiz Analytics</h3>
      </div>
      <div class="la-card-body">
        <div class="la-quiz-analytics" id="la-quiz-analytics"></div>
      </div>
    </div>

    <!-- Recording analytics -->
    <div class="la-card" id="la-card-recordings">
      <div class="la-card-header">
        <h3><span class="material-symbols-outlined">play_circle</span> Recording Engagement</h3>
      </div>
      <div class="la-card-body">
        <div class="la-recording-list" id="la-recording-analytics"></div>
      </div>
    </div>

    <!-- Resource analytics -->
    <div class="la-card" id="la-card-resources">
      <div class="la-card-header">
        <h3><span class="material-symbols-outlined">school</span> Resource Engagement</h3>
      </div>
      <div class="la-card-body">
        <div class="la-resource-list" id="la-resource-analytics"></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ ERROR / EMPTY STATES ═══════════════════ -->
  <div class="la-error" id="la-error" style="display:none;">
    <span class="material-symbols-outlined">error_outline</span>
    <span id="la-error-text">Failed to load analytics data.</span>
    <button class="la-btn la-btn-outline" id="la-error-retry" type="button">Retry</button>
  </div>

</div>
